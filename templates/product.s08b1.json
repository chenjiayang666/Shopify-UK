mpatible Apps","heading_tag":"h4","content":"<p>Merach, Kinomap, Zwift, Apple Health, Google Fit, Fantom Fite (By Merach).<\/p>","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}}},"block_order":["item_FWiCMj","item_NnRWkE","item_HxLrkL","item_AUKXdT","item_77zXwN","item_cmGzgG"],"settings":{"full_width":true,"stack_on_mobile":false,"gap":"medium","text_alignment":"center","subheading":"","title":"","content":"","background":"","background_gradient":"","text_color":""}},"accordion_content_ABVBL4":{"type":"accordion-content","blocks":{"item_VcpLPc":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"Controls and Functions","content":"<ul><li>Display: LCD<\/li><li>Programs: N\/A<\/li><li>Flywheel Weight: 3.5kg<\/li><li>Resistance Range: 8 Levels<\/li><li>Resistance Type: Magnetic<\/li><li>Pedal Type: Fixed<\/li><li>Suitable for User Height: 1.5m ~ 1.8m<\/li><li>LCD Data Monitor: Distance, Time, Calories Burned, Heart Rate, and other training data<\/li><li>Automatic Electromagnetic: No<\/li><li>Bluetooth: Yes<\/li><li>Accessory Holders: Phone\/Tablet Holder, Water Bottle Holder<\/li><\/ul>","page":""}},"item_NhAFCk":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"Machine Dimensions","content":"<ul><li>Weight Capacity: 136 kg<\/li><li>Assembled Dimensions: 131.5 x 63.5 x 97.5 (cm)<\/li><li>Carton Dimensions: 132 x 63.5 x 97.5 (cm)<\/li><li>Item Weight: 26 kg<\/li><li>Packed Weight: 28 kg<\/li><\/ul>","page":""}},"item_9MtECp":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"Intelligent software","content":"<p><strong>Support:<\/strong> MERACH, Kinomap, Zwift, Apple Health, Google Fit<br\/><br\/><strong>MERACH App Features:<\/strong><\/p><p>-Real-time training tracking<\/p><p>-Free fitness courses<\/p><p>-Progress tracking<\/p><p>-Workout reports over time<\/p><p>-Free training mode<\/p><p>-3D map training mode<\/p><p>-Training data<\/p><p>-PKs (Competitions) in courses<\/p>","p