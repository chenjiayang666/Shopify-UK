column_size":"3","title":"Free Merach App","heading_tag":"h4","content":"<p>Offers various FREE courses, programmed exercises, personalized training plans, training data, and more.<\/p>","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}},"item_E4eEQq":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Merach_NovaRow_R50_Pro_Air_Rower_35.jpg","column_size":"3","title":"Ergonomic Dynamic Seat","heading_tag":"h4","content":"<p>Perfectly adapts to your body for optimal comfort and support. The tailbone groove design reduces pressure, providing a comfortable seating experience.<\/p>","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}},"item_cmGzgG":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Merach_R50_Luft-Rudergerat-88_15.jpg","column_size":"3","title":"Compatible Apps","heading_tag":"h4","content":"<p>Merach, Kinomap, Apple Health, Google Fit.<\/p>","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}}},"block_order":["item_AUKXdT","item_HxLrkL","item_FWiCMj","item_77zXwN","item_YywGEt","item_NnRWkE","item_E4eEQq","item_cmGzgG"],"settings":{"full_width":true,"stack_on_mobile":false,"gap":"medium","text_alignment":"center","subheading":"","title":"","content":"","background":"","background_gradient":"","text_color":""}},"accordion_content_ABVBL4":{"type":"accordion-content","blocks":{"item_VcpLPc":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"Controls and Functions","content":"<h6><em><strong>Resistance<\/strong><\/em><\/h6><ul><li><strong>Resistance System<\/strong>: Pure wind resistance<\/li><li><strong>Resistance Levels<\/strong>: 10 levels<\/li><li><strong>Resistance Adjustment<\/strong>: Manual lever adjustment<\/li><li><strong>Fan Blades<\/strong>: 32 blades<\/li><li><strong>Flywheel Weight<\/strong>: 3.5 kg<\/li><\/ul><h6><em><strong>Other Information<\/strong><\/em><\/h6><ul><li><strong>Frame Material<\/strong>: Iron + Aluminum<\/li><li><strong>Folding Mechanism<\/strong>: Track disassembly<\/li><li><strong>Power Supply<\/strong>: Battery<\/li><li><strong>Handle Material<\/strong>: Plastic<\/li><li><strong>Pull Rope Material<\/strong>: Nickel-plated steel<\/li><li><strong>Handle Size<\/strong>: 510 mm<\/li><li><strong>Foot Pedal Adjustment<\/strong>: 6 adjustable lengths<\/li><li><strong>Foot Pedal Spacing<\/strong>: 90 mm<\/li><li><strong>Track Type<\/strong>: Single rail<\/li><li><strong>Track Material<\/strong>: Aluminum<\/li><li><strong>Sliding Rail Material<\/strong>: Stainless steel<\/li><li><strong>Track Length<\/strong>: 1365 mm<\/li><li><strong>Inner Gap Length<\/strong>: 1200 mm<\/li><li><strong>Track Incline<\/strong>: None<\/li><li><strong>Seat Material<\/strong>: Foam leather (ergonomic)<\/li><li><strong>Seat Height from Floor<\/strong>: 380 mm<\/li><li><strong>Seat Roller Material<\/strong>: PU<\/li><li><strong>Display Type<\/strong>: LCD Electronic Display<\/li><li><strong>Display Information<\/strong>: Time, Time\/500M, Distance, Calories, SPM, Watt, Strokes, Total Strokes, Pulse (Receiver built-in)<\/li><li><strong>iPad Stand<\/strong>: √<\/li><li><strong>Adjustable Stand Angle<\/strong>: √<\/li><li><strong>Heart Rate Monitoring<\/strong>: Supported<\/li><li><strong>Communication Method<\/strong>: Bluetooth<\/li><li><strong>Built-in Programs<\/strong>: None<\/li><li><strong>App<\/strong>: MERACH, Kinomap<\/li><li><strong>Courses<\/strong>: √<\/li><li><strong>Storage Method<\/strong>: Track folding storage<\/li><li><strong>Space Occupied (m³)<\/strong>: 0.73<\/li><li><strong>Max Weight Capacity<\/strong>: 158 kg<\/li><li><strong>Suitable Height<\/strong>: 3' 11\" - 6' 10\"<\/li><\/ul>","page":""}},"item_NhAFCk":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"Machine Dimensions","content":"<ul><li><strong>Folding Size<\/strong>: 635 * 835 * 1370 mm<\/li><li><strong>Unfolded Size<\/strong>: 2420 * 610 * 1020 mm<\/li><li><strong>Packaging Size<\/strong>: 1420 * 390 * 540 mm<\/li><li><strong>Net Weight<\/strong>: 33.3 kg<\/li><li><strong>Gross Weight<\/strong>: 39 kg<\/li><\/ul>","page":""}},"item_Nxwg4T":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"Warranty","content":"<ul><li>Frame: 24 months<\/li><li>Motor: 24 months<\/li><li>Parts: 24 months<\/li><li>Wear Parts: 24 months<\/li><li>Decoration Parts: 90 days<\/li><li>Commercial Use: Not available, for private use only.<\/li><\/ul>","page":""}},"item_Pgrxki":{"type":"item","disabled":true,"settings":{"icon":"none","icon_width":20,"title":"Packliste","content":"<ul><li>Hauptrahmenmontage*1<\/li><li>Vordere FuBrohr*1<\/li><li>Kissen*1<\/li><li>Linkes Podal*1<\/li><li>Stutzrohrmontage*1<\/li><li>Glcitschienen-Baugruppe*1<\/li><li>Rechtes Pedal*1<\/li><li>Schrauben & Zubehör*1<\/li><li>Sitzkissenassemblage×1*1<\/li><li>Benutzerhandbuch*1<br\/><br\/>Bitte überprüfen Sie, dass jede Komponente und jedes Zubehörteil vor demZusammenbau vollstandig ist.<\/li><\/ul>","page":""}},"item_KG8pzh":{"type":"item","disabled":true,"settings":{"icon":"none","icon_width":20,"title":"Benutzerhandbuch","content":"<p><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0570\/8280\/6344\/files\/Q1S_Pro_2.0_Merach_Magnetisches_Rudergerat.pdf?v=1734510063\" target=\"_blank\" title=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0570\/8280\/6344\/files\/Q1S_Pro_2.0_Merach_Magnetisches_Rudergerat.pdf?v=1734510063\">Download-Anleitung &lt;&lt;<\/a><\/p>","page":""}}},"block_order":["item_VcpLPc","item_NhAFCk","item_Nxwg4T","item_Pgrxki","item_KG8pzh"],"disabled":true,"settings":{"full_width":true,"subheading":"","title":"Product Specification","content":"<p>Here are the product details. If you need further information, please do not hesitate to contact us.<br\/><br\/>Email: <a href=\"mailto:info.uk@merachfit.com\" title=\"mailto:info.uk@merachfit.com\">info.uk@merachfit.com<\/a><\/p>","button_text":"","button_url":"","text_position":"start","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}},"faq_trEtAf":{"type":"faq","blocks":{"item_VDw37m":{"type":"item","settings":{"title":"1. Is the Merach R50 air rowing machine too noisy for a flat?","content":"<p>The Merach R50 uses a fan to create resistance, so a gentle whooshing sound is normal while rowing. The noise level is generally moderate and shouldn’t disturb neighbours, especially during the day. Many users actually find the sound motivating, as it increases with rowing intensity.<\/p>"}},"item_BCxLAh":{"type":"item","settings":{"title":"2. Does the Merach R50 air rowing machine provide a full-body workout?","content":"<p>Yes. The R50 engages over 80% of your major muscle groups, including legs, core, back, and arms. Rowing combines strength and cardio training, making it highly efficient — even a 20-minute session can deliver an effective full-body workout.<\/p>"}},"item_bE6BcK":{"type":"item","settings":{"title":"3. How does the 10-level air resistance system work?","content":"<p>The R50 uses a fan-based resistance system. The faster you row, the greater the resistance. It also has a 10-level adjustable damper to control airflow, allowing you to customise intensity from light cardio to challenging workouts.<\/p>"}},"item_UEMmxX":{"type":"item","settings":{"title":"4. Is the Merach R50 suitable for taller or heavier users?","content":"<p>Yes. The R50 has a sturdy steel frame and an extended rail for comfortable rowing. It supports a maximum user weight of 160 kg and provides plenty of room for users of different heights.<\/p>"}},"item_3TacMU":{"type":"item","settings":{"title":"5. How much space does the Merach R50 need at home?","content":"<p>The R50 has a foldable design and built-in transport wheels, making it easy to store upright or move around. This allows compact storage without sacrificing a full rowing experience — ideal for flats or small home gyms.<\/p>"}},"item_UUh4pB":{"type":"item","settings":{"title":"6. Is the Merach R50 easy to assemble and maintain?","content":"<p>Yes. It arrives around 90% pre-assembled, so setup is quick and simple. Maintenance is minimal thanks to the durable fan-based resistance system, which requires far less upkeep than friction-based rowers.<\/p>"}}},"block_order":["item_VDw37m","item_BCxLAh","item_bE6BcK","item_UEMmxX","item_3TacMU","item_UUh4pB"],"disabled":true,"name":"FAQ","settings":{"full_width":true,"subheading":"","title":"FAQ","content":"","team_avatar_width":160,"support_hours":"","answer_time":"","button_text":"","button_url":"","text_position":"center","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}},"specification_table_N4iPYp":{"type":"specification-table","blocks":{"row_FijwjU":{"type":"row","settings":{"heading":"Steuerelemente und Funktionen","value":"<p>111<\/p>"}},"row_jqYT34":{"type":"row","settings":{"heading":"Abmessungen der Maschine","value":"<p>Value 2<\/p>"}},"row_zdjWzD":{"type":"row","settings":{"heading":"Garantie","value":"<ul><li>Rahmen: 12 Monate<\/li><li>Motor: 12 Monate<\/li><li>Teile: 12 Monate<\/li><li>Verschleißteile: 12 Monate<\/li><li>Kosmetische Teile: 90 Tage<\/li><li>Gewerbliche Nutzung: Nicht verfügbar, nur für den privaten Gebrauch.<\/li><\/ul>"}}},"block_order":["row_FijwjU","row_jqYT34","row_zdjWzD"],"disabled":true,"settings":{"full_width":true,"subheading":"","title":"","content":"<p>Hier finden Sie die Details zum Produkt. Sollten Sie weitere Informationen benötigen, zögern Sie bitte nicht, uns zu kontaktieren.<\/p><p>E-Mail: <a href=\"mailto:info@merachfit.de\" target=\"_blank\" title=\"mailto:info@merachfit.de\">info@merachfit.de<\/a><\/p>","button_text":"","button_url":"","text_position":"start","max_rows":5,"view_all_text":"View all