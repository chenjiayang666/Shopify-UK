","content":"<p>The Merach NovaRow R50 Pro is built to last. Thanks to its high-wear-resistant bearings, low-friction technology, and ultra-quiet vibration system, it transforms every session into a smooth, powerful, and totally immersive experience.<\/p>","link_text":"","link_url":"","background":"#000000","background_gradient":"","text_color":"#ffffff","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_U3DLJp","image_t6K6Gk","image_U3Aiir"],"settings":{"full_width":false,"alternate_media_position":false,"spacing":"small"}},"rich_text_4BhJJq":{"type":"rich-text","blocks":{"heading_GEKJkT":{"type":"heading","settings":{"text":"","heading_tag":"h3","text_color":"","gradient":""}},"subheading_BhkU4y":{"type":"subheading","settings":{"text":""}},"richtext_hGmjCf":{"type":"richtext","disabled":true,"settings":{"content":"<p>Das duale Schienensystem sorgt für Stabilität und Sicherheit beim Training. Es bleibt auch bei intensivem Training ruhig und geschmeidig, mit einer maximalen Belastung von 160 kg.<\/p>"}}},"block_order":["heading_GEKJkT","subheading_BhkU4y","richtext_hGmjCf"],"settings":{"anchor_id":"rich-text","full_width":true,"content_width":"medium","text_position":"center","background":"","background_gradient":"","text_color":""}},"slideshow_CJHM3n":{"type":"slideshow","blocks":{"image_LcDeh8":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Merach_NovaRow_R50_Pro_Air_Rower_38.jpg","mobile_image":"shopify:\/\/shop_images\/Merach_NovaRow_R50_Pro_Air_Rower_21.jpg","content_max_width":580,"mobile_text_position":"place-self-start-center text-center","desktop_text_position":"sm:place-self-start-end sm:text-end","subheading":"Activates 6 Muscle Groups for a Comprehensiveeffort","title":"One Single Movement, the Whole Body","heading_tag":"h3","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","overlay_opacity":0,"background":""