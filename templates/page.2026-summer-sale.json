    "faq_MX99Qe": {
      "type": "faq",
      "blocks": {
        "item_7epCYj": {
          "type": "item",
          "settings": {
            "title": "1. Can I combine multiple discounts in one order?",
            "content": "<p>No, only one discount or coupon code can be applied per order. We recommend selecting the one that provides the greatest savings.</p>"
          }
        },
        "item_LBDrkg": {
          "type": "item",
          "settings": {
            "title": "2. Warranty Information",
            "content": "<p>All products purchased from uk.merachfit.com come with a one-year warranty.</p>"
          }
        },
        "item_PgzzbU": {
          "type": "item",
          "disabled": true,
          "settings": {
            "title": "3. How can I get the 5% new user discount?",
            "content": "<p>How: Sign up via the pop-up window on the right side of our website.<br/>Period: New users who register between October 27 and November 18, 2025, will receive an additional 5% discount. ( This offer is only valid between 27 October and 18 November. )</p>"
          }
        },
        "item_qkJBJT": {
          "type": "item",
          "settings": {
            "title": "3. How long will it take to receive my order?",
            "content": "<p>Order processing takes 1–2 business days after submission. Once processed, shipping usually takes 3–7 business days, depending on your location.<br/>(Except for special circumstances such as warehouse overflow during peak season or force majeure, e.g., floods, which may cause delivery delays.)</p>"
          }
        },
        "item_WpeJaT": {
          "type": "item",
          "settings": {
            "title": "4. About Flash Sales",
            "content": "<p>During Black Friday, we’ll be running 24-hour flash sales that will end either when the time runs out or when stocks sell out.<br/><br/><em>Note: Flash sale products are not covered by the 30-day price guarantee.</em></p>"
          }
        },
        "item_P4drWG": {
          "type": "item",
          "settings": {
            "title": "5. How can I contact Merach with questions about a promotion?",
            "content": "<p>If you have any questions about ongoing promotions or your order, please contact our support team:</p><p>📧 Email: info.uk@merachfit.com<br/>💬 Live Chat: Available at the bottom right corner of our website</p>"
          }
        }
      },
