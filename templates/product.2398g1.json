cht 9,88 KG. Dieses leichte Cardiogerät passt problemlos in jeden Raum in Ihrem Zuhause.<\/p>"}}},"block_order":["item_xHUJtK","item_BpkhEW","item_b8cxhD","item_rdtMQ6"],"disabled":true,"settings":{"full_width":false,"title":"","content":"","button_text":"","button_url":"","desktop_text_position":"place-self-start text-start","image_background":"","image_background_gradient":"","overlay_color":"#000000","overlay_opacity":0,"overlay_text_color":"#ffffff","overlay_button_background":"","overlay_button_text_color":"","hot_spot_dot_background":"#ffffff","hot_spot_dot_text_color":"#000000","hot_spot_content_background":"#ffffff","hot_spot_content_text_color":"#000000","hot_spot_content_opacity":90,"hot_spot_content_blur_radius":3}},"rich_text_fhAXNn":{"type":"rich-text","blocks":{"heading_LARKfK":{"type":"heading","settings":{"text":"What's in the box?","heading_tag":"h3","text_color":"","gradient":""}}},"block_order":["heading_LARKfK"],"settings":{"anchor_id":"rich-text","full_width":true,"content_width":"small","text_position":"center","background":"","background_gradient":"","text_color":""}},"images_with_text_scrolling_URXLDR":{"type":"images-with-text-scrolling","blocks":{"item_tfCHy3":{"type":"item","settings":{"icon":"none","icon_width":48,"title":"Unterhaltung und Fitness vereint","content":"<p>Nutze den Stepper, während du deine Lieblingsserie schaust oder Musik hörst – ganz bequem im Wohnzimmer. Stell dir vor, du trittst in die Pedale, während du einen spannenden Film siehst oder deine Lieblingsplaylist hörst. So kannst du dein Training mühelos in deinen Alltag integrieren und gleichzeitig Spaß haben!<\/p>"}},"item_wLBCgn":{"type":"item","settings":{"icon":"none","icon_width":48,"title":"Arbeiten und Trainieren gleichzeitig","content":"<p>Nutze den Stepper, während du am Schreibtisch arbeitest oder Telefonate führst. Stell dir vor, du trittst in die Pedale, während du E-Mails beantwortest oder an einer Besprechung teilnimmst. So kannst du dein Training problemlos in deinen Arbeitstag integrieren und gleichzeitig produktiv bleiben!<\/p>"}},"item_akix7x":{"type":"item","settings":{"icon":"none","icon_width":48,"title":"Perfekt für kleine Wohnungen","content":"<p>Der Stepper passt ideal in kleine Wohnungen, sodass du auch bei begrenztem Platz effektiv trainieren kannst. Stell dir vor, du nutzt ihn im Wohnzimmer oder sogar im Flur, während du deinen Alltag meisterst. Mit seinem kompakten Design (50 cm L × 32 cm B × 25 cm H) und der einfachen Handhabung lässt sich das Gerät problemlos verstauen, wenn es nicht in Gebrauch ist – perfekt für dein Zuhause!<\/p>"}}},"block_order":["item_tfCHy3","item_wLBCgn","item_akix7x"],"disabled":true,"settings":{"full_width":true,"stack_on_mobile":false,"show_counter":false,"desktop_image_effect":"reveal","image_position":"end","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":""}},"rich_text_cUbYk7":{"type":"rich-text","blocks":{"heading_8nMt4g":{"type":"heading","settings":{"text":"Allround-Muskeltraining","heading_tag":"h1","text_color":"","gradient":""}}},"block_order":["heading_8nMt4g"],"disabled":true,"settings":{"anchor_id":"rich-text","full_width":true,"content_width":"small","text_position":"center","background":"","background_gradient":"","text_color":""}},"image_with_text_overlay_fpXxB3":{"type":"image-with-text-overlay","settings":{"anchor_id":"image-with-text-overlay","full_width":true,"allow_transparent_header":false,"enable_parallax":false,"image_size":"auto","image":"shopify:\/\/shop_images\/2398G1_Merach_Vibrationsplatte_3.jpg","mobile_image":"shopify:\/\/shop_images\/2398G1_Merach_Vibrationsplatte_2.jpg","mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"accordion_content_ABVBL4":{"type":"accordion-content","blocks":{"item_VcpLPc":{"type":"item","settings":{"icon":"none","icon_width":20,"title":"