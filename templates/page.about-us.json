c.png","stretch_image":true,"link_text":"","link_url":"","background":"#000000","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"item_nnhVEL":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/merach_awards_new_4_fb86217e-0144-4c2e-961f-94165be5661e.png","stretch_image":true,"link_text":"","link_url":"","background":"#000000","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"item_D8MVPn":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/merach_awards_new_1_13e9e1ec-c82a-4d7f-ae14-782b20dec0df.png","stretch_image":true,"link_text":"","link_url":"","background":"#000000","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}}},"block_order":["item_pGYjga","item_rYQXc8","item_67gjXU","item_nBe99a","item_nnhVEL","item_D8MVPn"],"settings":{"full_width":true,"block_size":"medium","subheading":"","title":"","content":"","link_url":"","link_text":"","background":"#000000","background_gradient":"","text_color":"","heading_color":"","heading_gradient":""}},"rich_text_pMk689":{"type":"rich-text","blocks":{"heading_QNz3Pd":{"type":"heading","settings":{"text":"2018 Launch at Times Square","heading_tag":"h3","text_color":"","gradient":""}},"subheading_CzzV4w":{"type":"subheading","disabled":true,"settings":{"text":""}}},"block_order":["heading_QNz3Pd","subheading_CzzV4w"],"disabled":true,"settings":{"full_width":true,"content_width":"medium","text_position":"center","background":"#000000","background_gradient":"","text_color":"#f8f8f8"}},"images_with_text_scrolling_i4FHcD":{"type":"images-with-text-scrolling","blocks":{"item_D8J3AX":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Merach_Home_Fitness_Fruhlingsangebot_2025-6.jpg","icon":"none","icon_width":48,"title":"Unsere Geschichte","content":"<p>Im Jahr 2018 gründete Michel Merach mit einer einfachen, aber kraftvollen Mission: Die Art und Weise, wie Menschen Fitness erleben, zu verändern. Als jemand, der schon immer leidenschaftlich an Gesundheit interessiert war, bemerkte Michel ein häufiges Problem—viele Menschen hatten Fitnessbedürfnisse, aber fanden keinen Spaß an der Bewegung. Diese Kluft zwischen Wunsch und Handlung inspirierte ihn, etwas anderes zu schaffen.<\/p>"}},"item_z9TW6F":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Merach_Home_Fitness_Fruhlingsangebot_2025-5.jpg","icon":"none","icon_width":48,"title":"","content":"<p>Michels Vision war es, Fitness nicht nur zu einem Ziel, sondern zu einem Erlebnis zu machen. Er wollte die Kraft von smarter Technologie mit der natürlichen Freude an Bewegung verbinden. Durch den Einsatz von smarten Fitnessgeräten, die wichtige Körperdaten wie verbrannte Kalorien, Herzfrequenz und Fortschritte verfolgen, konnte Merach personalisierte Trainingspläne erstellen, die den Nutzern halfen, ihre Ziele effektiver zu erreichen. Doch Michel hörte hier nicht auf. Er wollte, dass Bewegung sich eher wie Spaß und weniger wie eine Pflicht anfühlte.<\/p>"}},"item_xJyfBq":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Merach_Brand_Story_1.jpg","icon":"none","icon_width":48,"title":"","content":"<p>Mit diesem Ziel vor Augen führte Merach innovative Geräte ein, die Outdoor-Szenen und spielähnliche Erlebnisse simulierten. Ob Nutzer durch Paris radelten, auf einem Fluss ruderten oder auf einem malerischen Bergweg liefen—Merach schuf eine Möglichkeit, Fitness spannend zu machen, fast wie ein Spiel oder wie das Genießen von Outdoorsportarten. Es ging darum, der menschlichen Natur zu entsprechen und den Instinkt zu wecken, zu entdecken und zu genießen.<\/p>"}},"item_xMgnWr":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Merach_Brand_Story_4.jpg","icon":"none","icon_width":48,"title":"","content":"<p>Die smarten Geräte von Merach halfen den Menschen, ihre Trägheit zu überwinden, und machten Fitness zugänglicher, unterhaltsamer und vor allem etwas, auf das man sich freute. Von diesem Moment an ging es bei Fitness nicht nur darum, Kalorien zu verbrennen – es ging darum, die Reise zu genießen.<\/p>"}}},"block_order":["item_D8J3AX","item_z9TW6F","item_xJyfBq","item_xMgnWr"],"disabled":true,"settings":{"full_width":true,"stack_on_mobile":false,"show_counter":false,"desktop_image_effect":"reveal","image_position":"end","background":"#f8f8f8","background_gradient":"","text_color":"#1a1a1a","heading_color":"","heading_gradient":""}},"slideshow_rbDMmW":{"type":"slideshow","blocks":{"image_RfNjnj":{"type":"image","settings":{"content_max_width":780,"mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","subheading":"Tell your story","title":"Slide 1","heading_tag":"h0","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","overlay_opacity":30,"background":"","background_gradient":""}},"image_FnRi8C":{"type":"image","settings":{"content_max_width":780,"mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","subheading":"Tell your story","title":"Slide 2","heading_tag":"h0","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","overlay_opacity":30,"background":"","background_gradient":""}}},"block_order":["image_RfNjnj","image_FnRi8C"],"disabled":true,"settings":{"full_width":false,"allow_transparent_header":true,"show_initial_transition":false,"image_size":"auto","controls_type":"dots","transition_type":"fade_with_text","autoplay":false,"cycle_speed":6,"background":"#f2f2f2","background_gradient":""}},"rich_text_XA7Vxc":{"type":"rich-text","blocks":{"subheading_gQ4XDT":{"type":"subheading","disabled":true,"settings":{"text":""}},"richtext_6iVdA9":{"type":"richtext","settings":{"content":"<p>MERACH feierte seine Weltpremiere auf dem Times Square in New York und begann damit seine Reise, um Fitness zu Hause f