_text":false,"required":false}},"text_8zA3q6":{"type":"text","settings":{"title":"Quantity (Min. 5)","use_long_text":false,"required":false}}},"block_order":["text_HEtqKh","text_8zA3q6"],"name":"Contact form","settings":{"full_width":true,"subheading":"For B2B orders ( Bulk order, customization, FOB orders), please contact B2B@merach.com","title":"Apply for Wholesale Order","content":"","text_position":"center","contact_form_size":"large","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","contact_background":"","contact_text_color":"","button_background":"","button_text_color":""}},"faq_yUMikF":{"type":"faq","blocks":{"item_m9nkFy":{"type":"item","settings":{"title":"1. How can I join Merach’s wholesale program?","content":"<p>Please send an email to B2B@merach.com with your preferred product list and include your country of purchase in the email subject line.<br\/>Merach will then offer you exclusive wholesale pricing once your request is approved.<\/p>"}},"item_PQhcTe":{"type":"item","settings":{"title":"2. Where will the wholesale orders be shipped from, and how long will it take?","content":"<p>Orders for the European markets are usually shipped from Germany warehouses and can be delivered within 7 days.<br\/><br\/>Please note that Merach does not cover shipping fees. Shipping costs vary by product, quantity, and destination.<\/p>"}},"item_PGC97V":{"type":"item","settings":{"title":"3. What information should I include when contacting Merach?","content":"<p>You should include: The product list (the items you wish to purchase).<br\/>The country\/region to be shipped to.<br\/>Any additional details such as estimated order volume, frequency, or sales channel.<\/p>"}},"item_xt9zYw":{"type":"item","settings":{"title":"4. Are there minimum order quantities or eligibility requirements?","content":"<p>There is 5 minimum order quantity. Requirements may vary depending on region and order size.<br\/>We recommend asking Merach directly for details when submitting your request.<\/p>"}},"item_bGcExR":{"type":"item","settings":{"title":"5. How long does it take to receive a response from Merach?","content":"<p>There is no specific timeframe. Providing complete details (product list, country, business info) will help Merach respond faster.<br\/>If you don’t receive a reply within a few business days, follow up via email.<\/p>"}}},"block_order":["item_m9nkFy","item_PQhcTe","item_PGC97V","item_xt9zYw","item_bGcExR"],"name":"FAQ","settings":{"full_width":true,"subheading":"","title":"FAQ","content":"","team_avatar_width":160,"support_hours":"Our customer support is available Monday to Friday: 9:30am-7:00pm.","answer_time":"","button_text":"","button_url":"","text_position":"center","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}}},"order":["main","rich_text_pVypkd","contact_jNUR8P","slideshow_7FpAFF","media_with_text_e7Ejit","multi_column_t9YUeG","rich_text_WGbmHQ","text_with_icons_VWhqPD","contact_eBkE6P","faq_yUMikF"]}