_title_position":"left","badge_Spare_bg_color_position":"left","stack_products":false,"show_progress_bar":false,"products_count":50,"products_per_row_mobile":"1","products_per_row_desktop":5,"background_tab":"","background":"","badge_Spare_bg_color_left":"#ffb74a","badge_Spare_bg_color_right":"#803cee","badge_Spare_color":"#ffffff","background_gradient":"","product_card_background":"","product_card_text_color":""}},"rich_text_hbnnBJ":{"type":"rich-text","blocks":{"heading_Q4GkLr":{"type":"heading","settings":{"text":"Merach Customer Story","heading_tag":"h2","text_color":"","gradient":""}}},"block_order":["heading_Q4GkLr"],"name":"Rich text","settings":{"anchor_id":"rich-text","full_width":true,"content_width":"large","text_position":"center","background":"","background_gradient":"","text_color":""}},"video_carousel_mH6HDb":{"type":"Video-Carousel","blocks":{"video_bigqUH":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/r50 father and daughter.mp4","video_url":"","title":""}},"video_aetUFK":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/r50 family rower.mp4","video_url":"","title":""}},"video_NKgHib":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/T26.mp4","video_url":"","title":""}},"video_6UNJGq":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/R28 WATER ROWING MACHINE.mp4","video_url":"","title":""}},"video_ppEMYT":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/S26B2.mp4","video_url":"","title":""}}},"block_order":["video_bigqUH","video_aetUFK","video_NKgHib","video_6UNJGq","video_ppEMYT"],"name":"Video list","settings":{"slider_gap":10,"card_radius":10,"autoplay":false,"full_width":true,"stack_collections":false,"collections_per_row":5,"show_progress_bar":true,"subheading":"","title":"","content":"","link_url":"","link_text":"","flex_direction":"row","flex_align":"center-center","section_bg":"","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":""}},"faq_Dpzg6z":{"type":"faq","blocks":{"item_4DRiYj":{"type":"item","settings":{"title":"Water, Magnetic, or Air Rowing Machine – Which One Is Right for You?","content":"<p><strong>Water Rowing Machine<\/strong><br\/><br\/>Pros:<br\/>1. Very realistic rowing feel thanks to real water resistance<br\/>2. Pleasant, calming water sound<br\/>3. Intensity automatically adapts to your pulling force<br\/><br\/>Cons:<br\/>1. Slightly heavier and larger than other models<br\/>2. Water needs to be refilled or changed occasionally<br\/>3. Usually higher priced<br\/><br\/><br\/><strong>Magnetic Rowing Machine<\/strong><br\/><br\/>Pros:<br\/>1. Very quiet operation – ideal for apartments<br\/>2. Smooth, controllable resistance<br\/>3. Compact and often foldable<br\/><br\/>Cons:<br\/>1. Less realistic rowing sensation<br\/>2. Resistance must be adjusted manually<br\/>3. Less dynamic workout compared to water or air<br\/><br\/><br\/><br\/><strong>Air Rowing Machine<\/strong><br\/><br\/>Pros:<br\/>1. Dynamic resistance – the harder you pull, the greater the intensity<br\/>2. Ideal for high-intensity interval training (HIIT)<br\/>3. Common in gyms – robust and high-performance<br\/><br\/>Cons:<br\/>1. Relatively loud due to airflow<br\/>2. Requires more space<br\/><br\/><br\/><strong><br\/>Conclusion for Your Home Gym:<\/strong><br\/>1. Limited space & need for quiet? → Magnetic Rowing Machine<br\/>2. Want a realistic feel & soothing atmosphere? → Water Rowing Machine<br\/>3. Looking for tough workouts & maximum intensity? → Air Rowing Machine<br\/><br\/>Tip: Choose the machine that best suits your lifestyle, training goals, and available space – so you stay motivated and consistent in the long run!<\/p>"}},"item_cCFgNj":{"type":"item","settings":{"title":"What’s the Best Treadmill for Home Use?","content":"<p>A treadmill is perfect for weather-independent training — whether you want to walk, jog, or run.<br\/><br\/>The best treadmill for you depends on your fitness goals, available space, and comfort preferences.<br\/><br\/>1. Foldable design for small spaces<br\/>2. Good cushioning to protect your joints<br\/>3. Bluetooth & app compatibility for interactive workouts<br\/>4. Quiet motor for peaceful indoor training<\/p>"}},"item_LtFaVk":{"type":"item","settings":{"title":"Which Rowing Machine Is the Best?","content":"<p>Rowing machines are true all-rounders – they train your legs, back, arms, and core at the same time, providing an intense cardio workout.<br\/><br\/>The best rowing machines stand out with realistic movement, quiet operation, and a space-saving design.<br\/><br\/>There are three main resistance systems to choose from:<br\/><br\/>1. Water – authentic rowing feel with a calming water sound<br\/>2. Magnetic – extra quiet, ideal for apartments<br\/>3. Air – dynamic resistance, perfect for HIIT workouts<br\/><br\/>Also look out for:<br\/>4. App connectivity for tracking your workouts<br\/>5. Adjustable seat height<br\/>6. Easy storage (e.g. foldable or upright positioning)<br\/><br\/>For anyone looking to combine full-body training with limited space – a rowing machine is the perfect choice!<\/p>"}},"item_B7WRRj":{"type":"item","settings":{"title":"What is the best home exercise bike?","content":"<p>Indoor bikes offer effective cardiovascular training with minimal joint impact. The best home exercise bike is quiet, stable, and adjusts to your needs – whether for beginners, seniors, or avid athletes.<br\/><br\/>There are differences, for example:<br\/><br\/>1. Upright bike: classic seating position, compact.<br\/>2. Recumbent ergometer: extra back support, very joint-friendly.<br\/>3. Speed bike (spinning): athletic & intense, ideal for interval training.<br\/>4. Adjustable seat & handlebars.<br\/>5. Heart rate monitoring and resistance adjustment.<br\/><br\/>Compatibility with apps like MERACH, Kinomap, or Zwift.<br\/>A good home exercise bike adds movement to your daily routine, regardless of weather or the gym.<\/p>"}},"item_CTFTee":{"type":"item","settings":{"title":"Which Elliptical Trainer is best for home use?","content":"<p>A Elliptical Trainer offers effective full-body training without putting too much strain on the joints – ideal for both beginners and advanced users.<br\/><br\/>The best model for your home should:<br\/><br\/>1. Be compact (space-saving, possibly foldable)<br\/>2. Run smoothly, even at higher intensity<br\/>3. Offer individually adjustable programs<br\/>4. Allow joint-friendly movement with a fluid motion<br\/><br\/><br\/>Cross trainers are especially popular among people who:<br\/><br\/>1. Want to burn calories<br\/>2. Want to lose weight gently on the joints<br\/>3. Or simply want to stay active regularly<br\/><br\/>Pay attention to app connectivity, flywheel weight, resistance levels, and comfort features – this is how you'll find your ideal workout partner for home use.<\/p>"}}},"block_order":["item_4DRiYj","item_cCFgNj","item_LtFaVk","item_B7WRRj","item_CTFTee"],"name":"FAQ","settings":{"full_width":true,"subheading":"","title":"FAQ","content":"","team_avatar_width":160,"support_hours":"","answer_time":"","button_text":"","button_url":"","text_position":"center","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}},"text_with_icons_YADEGi":{"type":"text-with-icons","blocks":{"item_dQGXpE":{"type":"item","settings":{"icon":"picto-coupon","custom_icon":"shopify:\/\/shop_images\/merachfit_uk_smart_home_fitness_trust_us_logo_3.png","mobile_icon_width":60,"icon_width":100,"icon_background_type":"circle","icon_background":"#ffffff","icon_color":"","title":"FREE SHIPPING","content":"<p>3-7 days fast delivery<\/p>"}},"item_3CGfAJ":{"type":"item","settings":{"icon":"picto-coupon","custom_icon":"shopify:\/\/shop_images\/merachfit_uk_smart_home_fitness_trust_us_logo_4.png","mobile_icon_width":60,"icon_width":100,"icon_back