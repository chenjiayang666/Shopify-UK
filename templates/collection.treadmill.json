false,"show_filter_values_count":true,"open_first_filter_group":false}},"rich_text_7GVnnc":{"type":"rich-text","blocks":{"heading_64CmHz":{"type":"heading","settings":{"text":"Why Own a Treadmill at Home?","heading_tag":"h1","text_color":"","gradient":""}},"richtext_XckabJ":{"type":"richtext","settings":{"content":"<p>A treadmill allows you to walk, jog, or run anytime—no need for a gym or good weather. It provides an effective, low-impact cardio workout that strengthens your legs, improves heart health, and boosts endurance. Whether your goal is weight loss, stamina building, or staying active, a treadmill helps burn calories and keep you moving. Plus, with adjustable speeds and incline options, it’s perfect for all fitness levels. Enjoy a convenient and consistent workout from the comfort of your home!<\/p>"}}},"block_order":["heading_64CmHz","richtext_XckabJ"],"settings":{"anchor_id":"rich-text","full_width":true,"content_width":"large","text_position":"start","background":"#f2f2f2","background_gradient":"","text_color":""}},"slideshow_iETYeN":{"type":"slideshow","blocks":{"image_yh8Tdr":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/merachfit_uk_top_smart_fitness_online_store_12.jpg","mobile_image":"shopify:\/\/shop_images\/merach_awards_2.jpg","content_max_width":780,"mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-start-center sm:text-center","subheading":"60 Million+ R&D Investment, 140+ Home Fitness Patents, 10 Million+ Users Selected","title":"","heading_tag":"h6","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","overlay_opacity":0,"background":"","background_gradient":""}},"image_7QQd3b":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/merachfit_uk_top_smart_fitness_online_store_11.jpg","mobile_image":"shopify:\/\/shop_images\/merach_awards_1.jpg","content_max_width":780,"mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","subheading":"","title":"","heading_tag":"h0","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","overlay_opacity":0,"background":"","background_gradient":""}}},"block_order":["image_yh8Tdr","image_7QQd3b"],"settings":{"full_width":false,"allow_transparent_header":true,"show_initial_transition":false,"image_size":"auto","controls_type":"dots","transition_type":"fade_with_text","autoplay":false,"cycle_speed":6,"background":"#f2f2f2","background_gradient":""}},"faq_zcGELp":{"type":"faq","blocks":{"item_Khf3Qz":{"type":"item","settings":{"title":"Comfortable & Joint-Friendly Design","content":"<p>Designed with multiple shock-absorbing layers and a silicone column system, the Merach Treadmill minimizes impact on your knees and joints. Whether you're walking, jogging, or running, enjoy a smooth and cushioned workout experience that reduces strain and enhances comfort—perfect for all fitness levels.<\/p>"}},"item_3HRCNH":{"type":"item","settings":{"title":"Stay Motivated with Smart App Integration","content":"<p>Pair your treadmill with the Merach app for an engaging fitness journey! Track your progress in real time, explore virtual running routes, and challenge yourself with interactive workouts. Whether you’re aiming for weight loss, endurance building, or daily activity goals, the app keeps you inspired and committed to your fitness routine.<\/p>"}},"item_CTQX6y":{"type":"item","settings":{"title":"Versatile Workout Modes for Every Fitness Level","content":"<p>With multiple speed settings and training modes, the Merach Treadmill adapts to your personal goals. Switch effortlessly between walking, jogging, and running to customize your workout intensity. Whether you're starting a new fitness journey or pushing your limits, this treadmill provides the flexibility and support you need.<\/p>"}}},"block_order":["item_Khf3Qz","item_3HRCNH","item_CTQX6y"],"settings":{"full_width":true,"subheading":"","title":"Why Choose the Merach Treadmill?","content":"<p>The Merach Treadmill offers a <strong>smooth, low-impact cardio workout<\/strong> to help you stay active, burn calories, and build endurance—all from the comfort of your home. With smart features, a <strong>sturdy design<\/strong>, and <strong>adjustable settings<\/strong>, it’s perfect for <strong>any fitness level<\/strong>. Take control of your health and enjoy a more active lifestyle with Merach!<\/p>","team_avatar_width":160,"support_hours":"","answer_time":"","button_text":"","button_url":"","text_position":"start","background":"#f2f2f2","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}},"multi_column_gDdKKL":{"type":"multi-column","blocks":{"item_VgQrQP":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/merachfit_uk_top_smart_fitness_online_store_5.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}},"item_DYxL3y":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/merach_smart_fitness_home_gym_uk_2.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}},"item_6EX7Yd":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/merach_smart_fitness_home_gym_uk_1.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link","check-bg":"#000000","check-color":"#ffffff"}}},"block_order":["item_VgQrQP","item_DYxL3y","item_6EX7Yd"],"settings":{"full_width":true,"stack_on_mobile":false,"gap":"medium","text_alignment":"center","subheading":"","title":"Foresee the Future","content":"<p>Home