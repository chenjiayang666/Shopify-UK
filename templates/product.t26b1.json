ground_gradient":"","heading_text_color":"","heading_gradient":"","text_color":"","button_background":"","button_text_color":""}},"media_with_text_DhFPkU":{"type":"media-with-text","blocks":{"image_U3DLJp":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/T26B1_Merach_3_in_1_Laufband_8.jpg","media_width":50,"media_position":"start","text_position":"place-self-center text-center","icon":"none","icon_width":48,"subheading":"Quiet Motor","title":"Support for High-Intensity Training","content":"<p>Equipped with a quiet 2.75 HP motor with a double turbine design, it delivers powerful performance. The built-in noise reduction plate keeps sound levels below 40 dB, allowing you to train without disturbing your family's peace.<\/p>","link_text":"","link_url":"","background":"#000000","background_gradient":"","text_color":"#ffffff","text_gradient":"","button_background":"","button_text_color":""}},"image_CqTifB":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/T26B1_Merach_3_in_1_Laufband_9.jpg","media_width":50,"media_position":"end","text_position":"place-self-center text-center","icon":"none","icon_width":48,"subheading":"Ultra-Thin Design 13 CM","title":"Easy to Store","content":"<p>The portable treadmill measures 116 x 47.6 x 13 cm and features an ultra-thin 13 cm profile with a detachable power cable, allowing you to store it upright or horizontally in any tight space. It fits perfectly into small areas.<\/p>","link_text":"","link_url":"","background":"#000000","background_gradient":"","text_color":"#ffffff","text_gradient":"","button_background":"","button_text_color":""}},"image_t6K6Gk":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/T26B1_Merach_3_in_1_Laufband_10.jpg","media_width":50,"media_position":"start","text_position":"place-self-center text-center","icon":"none","icon_width":48,"subheading":"Speed Range of 1-6 km\/h","title":"Adjust Your Training Pace Anytime","content":"<p>The speed range can be adjusted from 1-6 km\/h to better suit your training pace. The cable remote has magnetic properties and can be attached to any part of the treadmill to prevent loss.<\/p>","link_text":"","link_url":"","background":"#000000","background_gradient":"","text_color":"#ffffff","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_U3DLJp","image_CqTifB","image_t6K6Gk"],"settings":{"full_width":false,"alternate_media_position":false,"spacing":"small"}},"rich_text_4BhJJq":{"type":"rich-text","blocks":{"heading_GEKJkT":{"type":"heading","settings":{"text":"5 Layer Treadmill","heading_tag":"h1","text_color":"","gradient":""}}},"block_order":["heading_GEKJkT"],"settings":{"anchor_id":"rich-text","full_width":true,"content_width":"small","text_position":"center","background":"","background_gradient":"","text_color":""}},"image_with_text_overlay_8Nyq3x":{"type":"image-with-text-overlay","blocks":{"heading_wrbGrq":{"type":"heading","settings":{"text":"","heading_tag":"h1"}}},"block_order":["heading_wrbGrq"],"settings":{"anchor_id":"image-with-text-overlay","full_width":true,"allow_transparent_header":false,"enable_parallax":false,"image_size":"auto","image":"shopify:\/\/shop_images\/T26B1_Merach_3_in_1_Laufband_5.jpg","mobile_image":"shopify:\/\/shop_images\/T26B1_Merach_3_in_1_Laufband_2.jpg","mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":5}},"rich_text_BmQRfp":{"type":"rich-text","blocks":{"subheading_TDy4Wa":{"type":"subheading","settings":{"text":"The 5-layer treadmill includes a soundproof layer, shock-absorbing layer, high-strength support layer, compression layer, and a wear-resistant surface layer, ensuring optimal performance and protection for your joints during all levels of intensity."}}},"block_order":["subheading_TDy4Wa"],"settings":{"anchor_id":"rich-text","full_width":true,"content_width":"medium","text_position":"cen