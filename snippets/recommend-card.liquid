<div class="recommend-card {% if enable_slide %}swiper-slide{% endif %}">
    <a href="{{ product.url }}" class="recommend-media-box">
        {%- assign variant = product.selected_or_first_available_variant -%}
        {%- if variant.compare_at_price > variant.price -%}
          {%- liquid
            if settings.discount_mode == 'percentage'
              assign savings = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | append: '%'
            else
              assign savings = variant.compare_at_price | minus: variant.price | money
            endif
          -%}
          <div class="recommend-card__badge-list">
            <span class="badge badge--on-sale">{{ 'product.general.discount_badge_html' | t: savings: savings }}</span>
          </div>
        {%- endif -%}
        <img class="first-image" src="{{ product.featured_image | img_url:'' }}" alt="{{ product.featured_image.alt }}">
        <img class="second-image" src="{{ product.images[1] | img_url:'' }}" alt="{{ product.images[1].alt }}">
    </a>
    <div class="card-titile">
      {{ product.title }}
    </div>

    <div class="product-purchase mob-none">
        {%- render 'price-list', variant: product.selected_or_first_available_variant, size: 'lg' -%}
    </div>

    <div class="product-button">
        {%- capture product_form_id -%}product-form-{{ block.settings.product.id }}-{{ section.id }}{%- endcapture -%}
        {%- render 'buy-buttons', button_size:'sm',product: product, form_id: product_form_id, show_payment_button: false, show_gift_card_recipient: false, atc_button_background: block.settings.button_color, atc_button_text_color: block.settings.button_text_color, payment_button_background: block.settings.payment_button_background, payment_button_text_color: block.settings.payment_button_text_color -%}
        <div style="margin-top:10px !important">
        {%- render 'button', href: product.url, content: 'Learn more', size: 'sm', style: 'outline', background: '#ffffff', text_color: '#000000', stretch: true -%}
        </div>
    </div>
</div>