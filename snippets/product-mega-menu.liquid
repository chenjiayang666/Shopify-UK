{% assign block = mega_menu_block %}

{% assign valid_columns = 0 %}

{%- comment -%} 🔹 判断第 1 列 {%- endcomment -%}
{% if mega_menu_block.settings['column1-product1'] != blank or mega_menu_block.settings['column1-product2'] != blank %}
  {% assign valid_columns = valid_columns | plus: 1 %}
  {% assign column1_unempty = true %}
{% endif %}

{%- comment -%} 🔹 判断第 2 列 {%- endcomment -%}
{% if mega_menu_block.settings['column2-product1'] != blank or mega_menu_block.settings['column2-product2'] != blank %}
  {% assign valid_columns = valid_columns | plus: 1 %}
  {% assign column2_unempty = true %}
{% endif %}

{%- comment -%} 🔹 判断第 3 列 {%- endcomment -%}
{% if mega_menu_block.settings['column3-product1'] != blank or mega_menu_block.settings['column3-product2'] != blank %}
  {% assign valid_columns = valid_columns | plus: 1 %}
  {% assign column3_unempty = true %}
{% endif %}

<div data-megaTitle="{{ mega_menu_block.settings.menu_item }}" class="accordion-content product-mega-container">
  <div class="product-mega-box_layout {% if mega_menu_block.type == 'text_mega' %}text-mega-box{% endif %} {% if mega_menu_block.type == 'media_mega' %}media-mega-box{% endif %} {% if mega_menu_block.type == 'product_mega' %}product-mega-box{% endif %}">
    {% if mega_menu_block.type == 'product_mega' %}
      <div class="product-column-box">
        <div class="columns columns-{{ valid_columns }}">
          {% for col in (1..3) %}
            {% capture column1 %}column{{ col }}-product1{% endcapture %}
            {% capture column2 %}column{{ col }}-product2{% endcapture %}
            {% if mega_menu_block.settings[column1] != blank or mega_menu_block.settings[column2] != blank %}
              <div class="column column-{{ col }}">
                {% capture collection_title %}collection-title{{ col }}{% endcapture %}
                <div class="col-title mob-accordion-header">
                  {{ mega_menu_block.settings[collection_title] }}
                  <div class="pc-none mob-flex">
                    <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 6L6 1L11 6" stroke="black" stroke-opacity="0.65" stroke-linecap="round"/>
                    </svg>
                  </div>
                </div>

                <div class="mob-accordion-box">
                  <div class="column-product-box">
                    {% for i in (1..2) %}
                      {% capture column_product %}column{{ col }}-product{{ i }}{% endcapture %}
                      {% capture column_product_image %}column{{ col }}-product{{ i }}-image{% endcapture %}
                      {% capture column_product_title %}column{{ col }}-product{{ i }}-title{% endcapture %}
                      {% capture column_product_des %}column{{ col }}-product{{ i }}-des{% endcapture %}

                      {% if mega_menu_block.settings[column_product] != blank %}
                        {% assign product = mega_menu_block.settings[column_product] %}
                        {% assign image = mega_menu_block.settings[column_product_image] %}
                        {% assign title = mega_menu_block.settings[column_product_title] %}
                        {% assign des = mega_menu_block.settings[column_product_des] %}
                        <div class="column-product-card">
                          <a href="{{ product.url }}">
                            <img
                              src="{{ image | default: product.featured_image | img_url: 'master' }}"
                              alt="{{ product.featured_image.alt }}"
                            >

                            <div class="col-text-box">
                              <h4 class="col-card-title">{{ title | default: product.title | truncate: 15 }}</h4>
                              <span class="col-card-des">{{ des | default: product.description }}</span>
                            </div>
                          </a>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  <div class="col-more">
                    {% capture more_text %}more-text{{ col }}{% endcapture %}
                    {% capture more_link %}more-link{{ col }}{% endcapture %}
                    {% assign moretext = mega_menu_block.settings[more_text] %}
                    {% assign morelink = mega_menu_block.settings[more_link] %}
                    {% if moretext != balnk %}
                      <a href="{{ morelink }}">{{ moretext }}</a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="activity-box">
        {% if block.settings['activity-img'] != blank %}
          <img src="{{ block.settings.activity-img | img_url:'' }}" alt="{{ block.settings.activity-img.alt }}">
        {% endif %}
        <div class="column-buttons">
          {% if block.settings['activity-btn-text1'] != blank %}
            <a href="{{ block.settings.activity-btn-url1 }}">{{ block.settings['activity-btn-text1'] }}</a>
          {% endif %}
          {% if block.settings['activity-btn-text2'] != blank %}
            <a href="{{ block.settings.activity-btn-url2 }}">{{ block.settings['activity-btn-text2'] }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}
    {% if mega_menu_block.type == 'text_mega' %}
      {% for i in (1..4) %}
        {% capture title %}title{{i}}{% endcapture %}
        {% if mega_menu_block.settings[title] != blank %}
          <div class="text-mega-item">
            <h4 class="col-title mega-title mob-accordion-header">
              {{ mega_menu_block.settings[title] }}
              <div class="pc-none mob-flex">
                <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 6L6 1L11 6" stroke="black" stroke-opacity="0.65" stroke-linecap="round"/>
                </svg>
              </div>
            </h4>
            <div class="mob-accordion-box">
              <div class="mega-text-list">
                {% for j in (1..4) %}
                  {% capture text %}title{{i}}-text{{j}}{% endcapture %}
                  {% capture link %}title{{i}}-link{{j}}{% endcapture %}
                  {% if mega_menu_block.settings[text] != blank %}
                    <a href="{{ mega_menu_block.settings[link] }}" class="mega-text">
                      {{- mega_menu_block.settings[text] -}}
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
        {% if mega_menu_block.type == 'media_mega' %}
      {% for i in (1..8) %}
        {% capture title %}title{{i}}{% endcapture %}
        {% capture image %}image{{i}}{% endcapture %}
        {% capture text %}text{{i}}{% endcapture %}
        {% capture link %}url{{i}}{% endcapture %}
        {% capture tabtitle %}tab{{i}}{% endcapture %}

        {% if mega_menu_block.settings[image] != blank %}
          <div class="text-mega-item">
            <h4 class="col-title mega-title mob-accordion-header pc-none mob-flex">
              {{ mega_menu_block.settings[tabtitle] | default:'tab' }}
              <div class="pc-none mob-flex">
                <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 6L6 1L11 6" stroke="black" stroke-opacity="0.65" stroke-linecap="round"/>
                </svg>
              </div>
            </h4>
            <div class="mob-accordion-box media-item-box">
                <div class="media-item">
                    <a href="{{ mega_menu_block.settings[link] }}">
                        <img src="{{ mega_menu_block.settings[image] | img_url:'' }}" alt="{{ mega_menu_block.settings[image].alt }}">
                    </a>
                    <a href="{{ mega_menu_block.settings[link] }}" class="media-title">
                        <div>
                        {{- mega_menu_block.settings[title] -}}
                        </div>
                        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.815715 0.815633L5.76546 5.76538L0.815715 10.7151" stroke="black" stroke-opacity="0.8" stroke-width="1.63139" stroke-linecap="round"/>
                        </svg>
                    </a>
                    <a  href="{{ mega_menu_block.settings[link] }}" class="media-text">{{ mega_menu_block.settings[text] }}</a>
                </div>

            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div>
