{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  New Dev (MEGA) MENU PANEL
  ----------------------------------------------------------------------------------------------------------------------

  This component is used to show the different links in different panel for the menu drawer

  ********************************************
  Supported variables
  ********************************************

  * main_menu: the menu to show for the primary menu
  * secondary_menu: the secondary menu (shown on mobile)
  * layout: the layout of the menu (drawer or dropdown)
{%- endcomment -%}

<div class="panel-list__wrapper">
  <div class="panel">
    <div class="panel__wrapper first-level-panel__wrapper">
      <div class="panel__scroller v-stack gap-8">
        <ul class="tree-container">
          {%- for link in main_menu.links -%}
            {% comment %} 使用与header.liquid相同的方式解析菜单类型 {% endcomment %}
            {% assign title_arr = link.title | split: '@@' %}
            {% assign real_title = title_arr[0] %}
            {% assign menu_type = title_arr[1] | default: '' %}

            <li class="{% if link.links.size > 0 %} has-expand-below-item {% endif %} first-level-menu-item w-full first-level-font">
              {%- if link.links.size > 0 -%}
                {% assign title_handleize = link.title | handleize %}
                <button
                  single-open-and-wrap-selector=".first-level-panel__wrapper"
                  class="expand-below w-full text-with-icon group justify-between"
                  aria-expanded="false"
                  {% if link.links.size > 0 %}
                    content-class=".level-{{ link.levels }}-{{ title_handleize }}-content"
                  {% endif %}
                  data-panel="1-{% increment level_1 %}"
                >
                  <span style="position:relative" class="single_bottom">
                    {{ link.title }}
                                  {% for block in section.blocks %}
                {%if block.type == 'menu_tag' and block.settings.menu_item == link.title and block.settings.tag != blank%}
                  <div class="level-tag" style="color:{{block.settings.color }};background:{{ block.settings.background }}">{{block.settings.tag }}</div>
                {% endif %}
              {% endfor %}
                  </span>
                  {% if menu_type == 'bar' %}
                    <span class="bottom-thin-arrow group-hover:colors group-expanded:colors">
                      {%- render 'icon' with 'chevron-bottom-thin', direction_aware: true -%}
                    </span>
                  {% else %}
                    <span class="right-thin-arrow group-hover:colors group-expanded:colors">
                      <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0.499979 10.9165L5.70831 5.70817L0.499978 0.499837" stroke="#97999B" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  {% endif %}
                </button>
                {% if link.links.size > 0 %}
                  <ul class="expand-below-item-content v-stack level-{{ link.levels }}-{{ title_handleize }}-content">
                    {%- for sub_link_temp in link.links -%}
                      <li class="h6 second-level-menu-item">
                        {%- if sub_link_temp.links.size > 0 -%}
                          {% for block in section.blocks %}
                            {% if block.type == 'mega_item' and block.settings.menu_item == sub_link_temp.title %}
                              {% comment %} 三级展开触发点 {% endcomment %}
                              <button
                                class="text-with-icon w-full justify-between"
                                aria-expanded="false"
                                data-panel="2-{% increment level_2 %}"
                                panel-hide-index="0"
                              >
                                <span class="title-wrap">
                                  {{ sub_link_temp.title }}
                                </span>
                                <span class="right-thin-arrow group-hover:colors group-expanded:colors">
                                  <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <path d="M0.499979 10.9165L5.70831 5.70817L0.499978 0.499837" stroke="#97999B" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </span>
                              </button>
                            {% endif %}
                          {% endfor %}

                        {%- else -%}
                          <a class="group block w-full title-wrap" href="{{ sub_link_temp.url }}">
                            {{ sub_link_temp.title }}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {% endif %}
              {%- else -%}
                <a href="{{ link.url }}" class="group block w-full">
                  <span
                    ><span class="reversed-link">{{ link.title }}</span></span
                  >
                </a>
              {%- endif -%}

            </li>
            {%- if link.links.size > 0 -%}
              {%- capture link_level_2 -%}
                {{- link_level_2 -}}
                <div class="panel__wrapper second-level-panel__wrapper" hidden>
                  <ul class="v-stack gap-5">
                    <li class="back-level-line {% if layout != 'drawer' %}lg:hidden{% endif %}">
                      <button class="text-with-icon h6 text-in-drawer" data-panel="0">
                        {%- render 'icon' with 'chevron-left', direction_aware: true -%} {{ real_title }}
                      </button>
                    </li>

                    {%- if link.links.size > 0-%}
                        {%- for sub_link in link.links -%}
                          {% if sub_link.links.size > 0 %}
                            {% for block in section.blocks %}
                              {% if block.type == 'mega_item' and block.settings.menu_item == sub_link.title %}
                                {%- capture link_level_3 -%}
                                  {{- link_level_3 -}}
                                  <div class="panel__wrapper third-level-panel__wrapper" hidden>
                                      <ul class="v-stack ">
                                        <li class="back-level-line {% if layout != 'drawer' %}lg:hidden{% endif %}">
                                          <button class="text-with-icon h6 text-in-drawer" data-panel="0" panel-hide-index="2">{% comment %} 就目前需求，三级菜单的返回，应该返回一级菜单 {% endcomment %}
                                            {%- render 'icon' with 'chevron-left', direction_aware: true -%} {{ sub_link.title }}
                                          </button>
                                        </li>
                                      {% if block.settings.menu_type == 'type_1' %}
                                        <div class="dropdown-mega_item mega_item_check dropdown-mega_item_trigger">
                                          {% render 'mega-check-block', link: sub_link, block: block, is_mobile: true %}
                                        </div>
                                      {% endif %}
                                      {% if block.settings.menu_type == 'type_2' %}
                                        <div class="dropdown-mega_item mega_item_grid dropdown-mega_item_trigger">
                                          {% render 'mega-grid-block', link: sub_link, block: block, is_mobile: true %}
                                        </div>
                                      {% endif %}
                                      {% if block.settings.menu_type == 'type_3' %}
                                        <div class="dropdown-mega_item mega_item_slide dropdown-mega_item_trigger">
                                          {% render 'mega-slide-block', link: sub_link, block: block, is_mobile: true %}

                                        </div>
                                      {% endif %}
                                      {%if block.settings.menu_type=='type_4' %}
                                        <div class="dropdown-mega_item mega_item_links dropdown-mega_item_trigger">
                                          {% render 'mega-links-block', link: sub_link, block: block %}
                                        </div>
                                      {% endif %}
                                      </ul>
                                  </div>
                                {%- endcapture -%}
                              {%endif %}
                            {% endfor %}
                          {%- endif -%}
                        {%- endfor -%}
                    {%- endif -%}
                  </ul>
                </div>
              {%- endcapture -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if secondary_menu != blank -%}
          <ul class="v-stack gap-3">
            {%- for link in secondary_menu.links -%}
              {% assign title_arr = link.title | split: '@@' %}
              {% assign real_title = title_arr[0] %}
              <li>
                <a href="{{ link.url }}" class="h6 group"
                  ><span
                    ><span class="reversed-link">{{ real_title }}</span></span
                  ></a
                >
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- comment -%}一级菜单下方，展示的内容{%- endcomment -%}
        {% if section.settings.left_benefits != blank %}
          <div class="navigation-first-level-bottom">
            <div class="navigation-first-level-bottom-container">
              {% assign left_benefits_array = section.settings.left_benefits | split: ';' %}
              <div class="left-benefits-wrap">
                {% for left_benefits in left_benefits_array %}
                  {% assign left_benefits_array_item = left_benefits | split: ',' %}
                  <div class="benefits-item">
                    <img
                      src="{{ left_benefits_array_item[0] }}"
                      class="benefits-item-icon"
                      loading="lazy"
                      alt="{{ left_benefits_array_item[1] }}"
                      width="20"
                      height="20"
                    >
                    <span class="benefits-item-text">{{ left_benefits_array_item[1] }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      {%- comment -%}
        ----------------------------------------------------------------------------------------------------------------
        SOCIAL MEDIA + LOCALIZATION
        ----------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- if section.settings.show_social_media -%}
        {%- capture social_media -%}{%- render 'social-media' -%}{%- endcapture -%}
      {%- endif -%}

      {%- if show_country_selector and localization.available_countries.size > 1 -%}
        {%- assign country_selector = true -%}
      {%- endif -%}

      {%- if show_locale_selector and localization.available_languages.size > 1 -%}
        {%- assign locale_selector = true -%}
      {%- endif -%}

      {%- if social_media != blank or country_selector or locale_selector or shop.customer_accounts_enabled -%}
        <div class="panel-footer v-stack gap-5">
          {{- social_media -}}

          {% comment %}
            {%- if country_selector or locale_selector or shop.customer_accounts_enabled -%}
              <div class="panel-footer__localization-wrapper h-stack gap-6 border-t md:hidden">
                {%- if country_selector -%}
                  {%- render 'localization-selector',
                    type: 'country',
                    show_country_name: show_country_name,
                    show_country_flag: show_country_flag
                  -%}
                {%- endif -%}

                {%- if locale_selector -%}
                  {%- render 'localization-selector', type: 'locale' -%}
                {%- endif -%}

                {%- if shop.customer_accounts_enabled -%}
                  {% comment %} 移动端菜单侧栏，隐藏账号链接 {% endcomment %}
                  {% comment %} <a href="{{ routes.account_url }}" class="panel-footer__account-link hidden bold text-sm">
                    {{- 'header.general.account' | t -}}
                  </a> {% endcomment %}
                {%- endif -%}
              </div>
            {%- endif -%}
          {% endcomment %}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if link_level_2 != blank -%}
    <div class="panel gap-8">
      {{ link_level_2 }}
    </div>
  {%- endif -%}

  {%- if link_level_3 != blank %}
    <div class="panel">
      {{ link_level_3 }}
    </div>
  {%- endif -%}
</div>
