                  {% endif %}
                  <a class="block-media" href="{{ product.url }}">
                    {% if product.metafields.custom.header_featured_image != blank %}
                      <img
                        src="{{ product.metafields.custom.header_featured_image | image_url }}"
                        alt="{{ product.title }}"
                        loading="lazy"
                      >
                    {% else %}
                      <img src="{{ product.featured_image | image_url }}" loading="lazy" alt="{{ product.title }}">
                    {% endif %}
                  </a>
                  <div class="block-content">
                    <div class="block-title">{{ product.metafields.custom.custom_product_title | default: product.title }}</div>
                    <div class="block-des">
                      {{ product.metafields.custom.custom_description | metafield_tag | default: product.description }}
                    </div>
                    <div class="block-price">{{ product.price | money }}</div>

                    <div class="block-rating">
                      <a
                        href="{{ product.url }}"
                        class="shop-all-btn header-shop-all-btn"
                      >
                        Shop Now
                      </a>
                      {% if product.metafields.custom.custom_cta_url != blank %}
                        <a href="{{ product.metafields.custom.custom_cta_url }}" class="product-card-btn">
                          {{- product.metafields.custom.custom_cta_text | default: 'Explore' -}}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {% if block.settings.product != blank %}
      {%- assign right_image = block.settings.image | default: block.settings.product.featured_image -%}
      {%- assign right_url = block.settings.link_url | default: block.settings.product.url -%}
      <div class="block-right-card">
        {%- if right_image != blank -%}
          <a class="right-card-media" href="{{ right_url }}">
            <img
              src="{{ right_image | image_url: width: 400 }}"
              alt="{{ block.settings.image.alt | default: block.settings.product.title | escape }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
        <div class="right-card-content">
          <div class="right-card-title">{{ block.settings.title | default: block.settings.product.title }}</div>
          <div class="right-card-des">
            {{ block.settings.description | default: block.settings.product.description | strip_html | truncate: 75 }}
          </div>
          <a class="right-card-btn" href="{{ right_url }}">
            {{- block.settings.link_text | default: 'Shop Now' | escape -}}
          </a>
        </div>
      </div>
    {% endif %}
  </div>
  <script>
    (function () {
      function initMegaCheckBlock() {
        const container = document.getElementById('mega-check-block-{{ block.id }}');
        if (!container) return;

        const tabs = container.querySelectorAll('.check-tab-item');
        const panes = container.querySelectorAll('.check-content-pane');

        tabs.forEach((tab, index) => {
          tab.addEventListener('mouseenter', () => {
            tabs.forEach((t) => t.classList.remove('active'));
            panes.forEach((p) => p.classList.remove('active'));

            tab.classList.add('active');
            if (panes[index]) {
              panes[index].classList.add('active');
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMegaCheckBlock);
      } else {
        initMegaCheckBlock();
      }
    })();
  </script>
{%- endif -%}
