{%- render 'section-spacing-collapsing' -%}

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  CSS
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
      #shopify-section-{{ section.id }} .section{
    {% if section.settings.background_image != blank %}
      background-image:url({{ section.settings.background_image | img_url: ''  }});
      background-size: cover;
      background-repeat: no-repeat;
    {% endif %}
  }
  @media (min-width:768px){
    .content-over-media__media.h5 {
      display: none;
    }
  }
  @media (max-width:767px){
    .content-over-media__media.pc {
      display: none;
    }

    #shopify-section-{{ section.id }} .section{
    {% if section.settings.background_image_mob != blank %}
      background-image:url({{ section.settings.background_image_mob | img_url: ''  }});
      background-size: cover;
      background-repeat: no-repeat;
    {% endif %}
  }
  }

  #shopify-section-{{ section.id }} {
    --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
    --media-grid-column: {{ section.settings.mobile_column }};
  }
  #shopify-section-{{ section.id }} .text-block-description {
    margin-top: var(--spacing-2);
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
      --media-grid-column: {{ section.settings.desktop_column }};
    }
    #shopify-section-{{ section.id }} .text-block-description {
      margin-top: var(--spacing-5);
    }
  }

  {%- for block in section.blocks -%}
    #media-grid-{{ block.id }} {
      --content-over-media-overlay: {{ block.settings.overlay_color.rgb }} /{{ block.settings.overlay_opacity | divided_by: 100.0 }};

      {%- if block.settings.heading_tag == 'h5' or block.settings.heading_tag == 'h6' -%}
        --content-over-media-gap: 1rem;
      {%- endif -%}
    }

    {%- if block.settings.heading_tag == 'h5' or block.settings.heading_tag == 'h6' -%}
      @media screen and (min-width: 740px) {
        #media-grid-{{ block.id }} {
          --content-over-media-gap: 1.5rem;
        }
      }
    {%- endif -%}
  {%- endfor -%}
</style>

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}



<div
  {% render 'section-properties', narrow: section.settings.reduce_width %}
>
  <media-grid class="custom-media-grid">
    {%- for block in section.blocks -%}
      {% comment %} 解析出行列范围 {% endcomment %}
      {% assign desktop_rows_columns = block.settings.desktop_layout_ranges | split: ',' %}
      {% assign desktop_row_ranges = desktop_rows_columns[0] | split: '-' %}
      {% assign desktop_column_ranges = desktop_rows_columns[1] | split: '-' %}
      {% assign mobile_rows_columns = block.settings.mobile_layout_ranges | split: ',' %}
      {% assign mobile_row_ranges = mobile_rows_columns[0] | split: '-' %}
      {% assign mobile_column_ranges = mobile_rows_columns[1] | split: '-' %}
      {% comment %} 下面计算span数 {% endcomment %}
      {% assign start_range = desktop_column_ranges[0] | plus: 0 %}
      {% assign end_range = desktop_column_ranges[1] | plus: 0 %}
      {% assign desktop_column_span = end_range | minus: start_range %}
      <style>
          .{{block.id}}.custom-media-grid__item {
            --media-grid-column-start: {{ mobile_column_ranges[0] }};
            --media-grid-column-end: {{ mobile_column_ranges[1] }};
            --media-grid-row-start: {{ mobile_row_ranges[0] }};
            --media-grid-row-end: {{ mobile_row_ranges[1] }};
          }
        @media screen and (min-width: 700px) {
          .{{block.id}}.custom-media-grid__item {
            --media-grid-column-start: {{ desktop_column_ranges[0] }};
            --media-grid-column-end: {{ desktop_column_ranges[1] }};
            --media-grid-row-start: {{ desktop_row_ranges[0] }};
            --media-grid-row-end: {{ desktop_row_ranges[1] }};
          }
        }
        @media (max-width:767px) {
          #media-grid-{{ block.id }} .prose>* {
            font-size: {{ block.settings.h5_font_size }};
          }
        }
      </style>
      <a
        {% if block.settings.link_url != blank %}
          href="{{ block.settings.link_url }}"
        {% endif %}
        class="{{block.id}} custom-media-grid__item shadow group"
        reveal-js
        {{ block.shopify_attributes }}
      >
        {% comment %} style="--media-grid-column-start: {{ desktop_column_ranges[0] }}; --media-grid-column-end: {{ desktop_column_ranges[1] }}; --media-grid-row-start: {{ desktop_row_ranges[0] }}; --media-grid-row-end: {{ desktop_row_ranges[1] }}" {% endcomment %}
        <div
          id="media-grid-{{ block.id }}"
          {% render 'surface',
            class: 'content-over-media rounded',
            background: block.settings.background,
            background_gradient: block.settings.background_gradient,
            text_color: block.settings.text_color
          %}
        >
          {%- liquid
            assign loading_strategy = null

            if section.index > 3 or forloop.index > 3
              assign loading_strategy = 'lazy'
            endif
          -%}

          {%- case block.type -%}
            {%- when 'text' -%}
              <div
              class="{{ block.settings.mobile_text_position }} {{ block.settings.desktop_text_position }} text-block-wrap">
                {%- if block.settings.block_title -%}
                  <div class="text-block-title {{ block.settings.heading_tag }}">
                    {% render 'styled-text',
                      content: block.settings.block_title,
                      gradient: block.settings.text_gradient
                    %}
                  </div>
                {%- endif -%}
                {% if block.settings.description %}
                  <div class="text-block-description" style="font-size:{{ block.settings.description_font_size }}">
                    {% render 'styled-text',
                      content: block.settings.description,
                      gradient: block.settings.text_gradient
                    %}
                  </div>
                {% endif %}
              </div>
            {%- when 'image' -%}
              {%- if block.settings.image -%}
                {%- capture sizes -%}min({{ 390 | times: desktop_column_span }}px, {{ 25 | times: desktop_column_span }}vw){%- endcapture -%}
                {{-
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    loading: loading_strategy,
                    sizes: sizes,
                    widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800,2000,2200,2400',
                    class: 'pc content-over-media__media zoom-image'
                -}}
                {%- capture sizes_two -%}100vw{%- endcapture -%}
                {%- if block.settings.mobile_image -%}
                  {{-
                    block.settings.mobile_image
                    | image_url: width: block.settings.mobile_image.width
                    | image_tag:
                      loading: loading_strategy,
                      sizes: sizes_two,
                      widths: '200,300,400,500,600,700,800,1000,1200',
                      class: 'h5 content-over-media__media zoom-image'
                  -}}
                {%- endif -%}
              {%- endif -%}

            {%- when 'video' -%}
              {%- if block.settings.video -%}
                <video-media autoplay style="--aspect-ratio: auto">
                  {%- if block.settings.show_video_controls -%}
                    {%- assign loop_video = false -%}
                  {%- else -%}
                    {%- assign loop_video = true -%}
                  {%- endif -%}

                  {{-
                    block.settings.video
                    | video_tag:
                      playsinline: true,
                      muted: true,
                      loop: loop_video,
                      controls: block.settings.show_video_controls,
                      preload: 'metadata',
                      class: 'object-fill'
                  -}}
                </video-media>
              {%- else -%}
                <video-media host="{{ block.settings.external_video_url.type }}" autoplay style="--aspect-ratio: auto">
                  <template>
                    {%- if block.settings.external_video_url.type == 'youtube' -%}
                      <iframe
                        src="https://www.youtube.com/embed/{{ block.settings.external_video_url.id }}?playsinline=1&autoplay=1&controls=0&mute=1&loop=1&playlist={{ block.settings.external_video_url.id }}&enablejsapi=1&rel=0&modestbranding=1&origin={{ 'https://' | append: request.host | url_encode }}"
                        allow="autoplay; encrypted-media"
                        allowfullscreen="allowfullscreen"
                      ></iframe>
                    {%- elsif block.settings.external_video_url.type == 'vimeo' -%}
                      <iframe
                        src="https://player.vimeo.com/video/{{ block.settings.external_video_url.id }}?autoplay=1&autopause=1&background=1&loop=1&muted=1&transparent=0&responsive=1&portrait=0&title=0&byline=0&color={{ settings.text_color | remove_first: '#' }}"
                        allow="autoplay; encrypted-media;"
                        allowfullscreen="allowfullscreen"
                      ></iframe>
                    {%- endif -%}
                  </template>
                </video-media>
              {%- endif -%}
          {%- endcase -%}

          {%- if block.settings.title != blank or block.settings.link_text != blank -%}
            <div class="{{ block.settings.mobile_text_position }} {{ block.settings.desktop_text_position }}">
              <div class="prose">
                {%- if block.settings.title != blank -%}
                  <p class="{{ block.settings.heading_tag }}">
                    {% render 'styled-text', content: block.settings.title, gradient: block.settings.text_gradient %}
                  </p>
                {%- endif -%}

                {%- if block.settings.link_text != blank -%}
                  {%- render 'button',
                    size: 'lg',
                    content: block.settings.link_text,
                    background: block.settings.button_background,
                    text_color: block.settings.button_text_color
                  -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </media-grid>
</div>
