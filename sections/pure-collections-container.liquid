
<style>
  @media (max-width:767px) {
    #shopify-section-{{ section.id }} .custom-tabs{
      justify-content: flex-start !important;/* 我觉得h5端就应该这样放置 */
    }
    #shopify-section-{{ section.id }} > .section {
      background-image: url({{ section.settings.h5_background_image | image_url }});
      background-position: center center;
      background-size: auto 100%;
      background-repeat: no-repeat;
    }

  }
  @media (min-width:768px) {
    #shopify-section-{{ section.id }} .tab-link:hover {
      background-color: #ddd;
    }
    #shopify-section-{{ section.id }} > .section {
      background-image: url({{ section.settings.pc_background_image | image_url }});
      background-position: center center;
      background-size: auto 100%;
      background-repeat: no-repeat;
    }
  }
   #shopify-section-{{ section.id }}  {
    background-color: {{section.settings.background_tab}}
  }

  #shopify-section-{{ section.id }} > .section {
    padding-top: 20px;
  }
  #shopify-section-{{ section.id }} .custom-tabs{
    display: flex;
    justify-content: flex-start;
    align-items: center;
    overflow-y: hidden;
    overflow-x: auto;
    width: fit-content;
    height: fit-content;
    background-color: {{ section.settings.whole_tabs_bg_color }};
    margin-top: 15px;
    margin-bottom: 15px;
    border-radius: 20px;
  }
  #shopify-section-{{ section.id }} .custom-tabs-wrap {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .tab-link {
    white-space: nowrap;
    color: {{section.settings.tab_font_color}};
    padding:0 20px;
    height:40px;
    cursor:default;
    border-radius: 40px;
    display:flex;
    justify-content: center;
    align-items: center;
    transition: 0.3s;
    font-size: 17px;
    border: 2px solid transparent;
  }

  #shopify-section-{{ section.id }} .tab-link.active {
    color: {{section.settings.active_tab_font_color}};
    border: 2px solid #000;
    background-color: #fff;
  }

  #shopify-section-{{ section.id }} .tab-content {
    display: none;
    padding: 6px 12px;
    border: 1px solid #ccc;
    border-top: none;
  }
  {% if section.settings.fit_black_background == true %}
    #shopify-section-{{ section.id }} .custom-tabs {
      border: 2px solid #fff;
      background: #000;
      color: #fff;
    }
    #shopify-section-{{ section.id }} .tab-link {
      color: #fff;
    }
    #shopify-section-{{ section.id }} .tab-link.active {
      color: #000000;
      border: 2px solid #000;
      background-color: #fff;
    }
  {% endif %}
  {% if section.settings.heading_fix_height != 0 %}
    #shopify-section-{{ section.id }} .product-card__title {
      height: {{ section.settings.heading_fix_height }}px;
      overflow: hidden;
    }
  {% endif %}
  #shopify-section-{{ section.id }} .product-card .badge{
     /* 渐变背景 - 从左到右 */
          background-image: linear-gradient(
            90deg,
            {{ section.settings.badge_Spare_bg_color_left }},
            {{ section.settings.badge_Spare_bg_color_right }}
          );
    color: {{section.settings.badge_Spare_color}};
    padding: 5px 12px;
     border-radius: 8px;

  }
    /* top: 1rem;
    background-image: linear-gradient(90deg, #7d9bc1, #e1e9f0);
    width: max-content;
    display: inline-block;
    padding: 5px 12px;
    border-radius: 8px;
    color: #1a1a1a;
    font-weight: bold;
    font-size: 14px;
    overflow: hidden;
    right: 1rem; */
   #shopify-section-{{ section.id }} .product-card .product-card__badge-list{
     width: max-content;
    {% if section.settings.badge_Spare_bg_color_position == 'left'  %}
      left: var(--product-card-badge-spacing);
    {% elsif section.settings.badge_Spare_bg_color_position == 'center' %}
      left: 50%;
          transform: translateX(-50%);
    {% else %}
      right: var(--product-card-badge-spacing);
      left: auto;
      {% endif %}
  }
  #shopify-section-{{ section.id }} .section-header{
    {% if section.settings.products_title_position == 'left'  %}
      justify-content: space-between;
    {% elsif section.settings.products_title_position == 'center' %}
      justify-content: center;
    grid-template-columns: auto;
    {% else %}
      justify-content: end;
    grid-template-columns: auto;
      {% endif %}
  }
   #shopify-section-{{ section.id }} .custom-tabs-wrap{
     display: flex;
    {% if section.settings.products_title_position == 'right'  %}
      justify-content: right;
    {% elsif section.settings.products_title_position == 'center' %}
      justify-content: center;
      {% endif %}
  }
  #shopify-section-{{ section.id }} .section{
    padding-bottom: {{section.settings.padding-bottom}}px;
    padding-top: {{section.settings.padding-top}}px;
    margin-top: 0px;
    margin-bottom: 0px;
  }
  @media (max-width:767px) {
        #shopify-section-{{ section.id }} .section {
          padding-bottom: {{section.settings.padding-bottom-mob}}px;
      padding-top: {{section.settings.padding-top-mob}}px;
    }
  }
  /* badge_Spare_bg_color_position */
</style>

    <div {% render 'section-properties' %}>
      {%- render 'section-header', heading: section.settings.title, heading_color: section.settings.heading_color -%}
      <div class="custom-tabs-wrap" id="feature-list-{{ section.settings.anchor_id | default: section.id }}">
        <div class="custom-tabs">
          {% assign tab_block_index = 0 %}
          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when 'tab' -%}
                {% assign tab_block_index = tab_block_index | plus: 1 %}
                {%- if tab_block_index == 1 -%}
                  <div class="tab-link active" data-block-id="{{block.id}}">
                    {% comment %} onclick="openTab(event, '{{ block.id }}',{{forloop.index}})" {% endcomment %}
                    {{ block.settings.title }}
                  </div>
                {% else %}
                  <div class="tab-link" data-block-id="{{block.id}}">
                    {{ block.settings.title }}
                  </div>
                {% endif %}
            {%- endcase -%}
          {% endfor %}
        </div>
      </div>
      {% assign products_collection_block_index = 0 %}
      {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when 'products_collection' -%}
            {% assign products_collection_block_index = products_collection_block_index | plus: 1 %}
            {%- if products_collection_block_index == 1 -%}
              {%- assign dev_class = 'dev-product-list' | append: ' active' -%}
            {%- else -%}
              {%- assign dev_class = 'dev-product-list' -%}
            {%- endif -%}
            {%- if block.settings.collection.products -%}
              {%- render 'pure-collections',
                type: 'collection',
                fit_black_background: section.settings.fit_black_background,
                discount_texts: block.settings.discount_texts,
                rewrite_titles: block.settings.rewrite_titles,
                stage_count: section.settings.stage_count,
                lead_to_click_text: section.settings.lead_to_click_text,
                want_tags: section.settings.want_tags,
                provider_logo: section.settings.provider_logo,
                list_content: block.settings.collection,
                custom_descriptions: block.settings.custom_descriptions,
                list_section: section,
                dev_class: dev_class,
                block_id: block.id,
                collections_layout_mode: section.settings.collections_layout_mode,
                stack_products: section.settings.stack_products,
                discount_mode: block.settings.discount_mode
              -%}
            {%- elsif block.settings.products -%}
              {%- render 'pure-collections',
                type: 'products',
                fit_black_background: section.settings.fit_black_background,
                discount_texts: block.settings.discount_texts,
                rewrite_titles: block.settings.rewrite_titles,
                stage_count: section.settings.stage_count,
                lead_to_click_text: section.settings.lead_to_click_text,
                want_tags: section.settings.want_tags,
                provider_logo: section.settings.provider_logo,
                list_content: block.settings.products,
                custom_descriptions: block.settings.custom_descriptions,
                list_section: section,
                dev_class: dev_class,
                block_id: block.id,
                collections_layout_mode: section.settings.collections_layout_mode,
                stack_products: section.settings.stack_products,
                discount_mode: block.settings.discount_mode
              -%}
            {% endif %}
        {%- endcase -%}
      {% endfor %}
    </div>

<script type="module">
  const customTabs = document.querySelector('#shopify-section-{{ section.id }} .custom-tabs');
  const tabContents = document.querySelectorAll('#shopify-section-{{ section.id }} .dev-product-list');
  const tablinks = customTabs.querySelectorAll('#shopify-section-{{ section.id }} .tab-link');
  Array.from(tablinks).forEach((item, index) => {
    item.addEventListener('click', (evt) => {
      for (let i = 0; i < tablinks.length; i++) {
        tablinks[i].className = tablinks[i].className.replace(' active', '');
        tabContents[i].className = tabContents[i].className.replace(' active', '');
      }
      item.style.display = 'flex';
      tabContents[index].classList.add('active');
      evt.currentTarget.className += ' active';
    });
  });
</script>

