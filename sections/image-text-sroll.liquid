{% render 'section-settings' %}



<div class="{% if section.settings.show_content =='pc' %}sm:block sm-max:hidden{%endif %}  {% if section.settings.show_content =='mobile' %}sm:hidden sm-max:block{%endif %}">

<section class="image-text-sroll section-padding">
  <div class="image-text-sroll-container section-maxwidth section-gap">
    <div class="image-slide-item image-slide-swiper image-slide-swiper-{{section.id }}">
      {% if section.blocks.size > 0 %}
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'item' %}
              <div class="image-slide-item__content swiper-slide">

                {%if block.settings.img_text != blank %}
                  <div class="img-text">{{ block.settings.img_text }}</div>
                {% endif %}

                {% if block.settings.video != blank %}
                  <div class="sm:block sm-max:hidden">
                    {{-
                      block.settings.video
                      | video_tag:
                        playsinline: true,
                        preload: 'metadata',
                        autoplay: true,
                        muted: true,
                        loop: true,
                        controls: false,
                        image_size: '800x',
                        class: 'lazy-video  media pc-video pc-control'
                    -}}
                  </div>

                {% elsif block.settings.image != blank %}
                  <img
                    class="sm:block sm-max:hidden media pc-control"
                    src="{{ block.settings.image | img_url:''}}"
                    alt="{{ block.settings.image.alt }}"
                    loading="lazy"
                  >
                {% endif %}

                {% if block.settings.video_m != blank %}
                  <div class="sm:hidden sm-max:block">
                    {{-
                      block.settings.video_m
                      | video_tag:
                        playsinline: true,
                        preload: 'metadata',
                        muted: true,
                        loop: true,
                        autoplay: true,
                        controls: false,
                        image_size: '800x',
                        class: 'lazy-video  media'
                    -}}
                  </div>
                {% elsif block.settings.image_mob != blank %}
                  <img
                    class="sm:hidden sm-max:block media"
                    src="{{ block.settings.image_mob | img_url:'' }}"
                    alt="{{ block.settings.image_mob.alt }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="image-slide-pagination image-slide-pagination-{{ section.id }}"></div>
      {% endif %}
    </div>
    <div class="text-slide-item text-slide-swiper text-slide-swiper-{{section.id }}">
      {% if section.blocks.size > 0 %}
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'item' %}
              <div class="text-slide-item__content swiper-slide">
                {% if block.settings.title != blank %}
                  <h3 class="text-slide-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="text-slide-desc">{{ block.settings.text }}</div>
                {% endif %}
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="text-slide-link">Shop Now</a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
        <div class="image-slide-pagination-mob image-slide-pagination-mob-{{ section.id }}"></div>
        <div class="button-groups">

            <div class="image-slide-button-prev slide-button">
                <svg  width="8" height="15" viewBox="0 0 17 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14.9805 1.11133L1.5704 14.5214L14.9805 27.9315" stroke="black" stroke-opacity="1" stroke-width="2.22138" stroke-linecap="round"/>
                </svg>
            </div>
                        <div class="image-slide-button-next slide-button">                
                <svg style="transform:rotate(180deg)" width="8" height="15" viewBox="0 0 17 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14.9805 1.11133L1.5704 14.5214L14.9805 27.9315" stroke="black" stroke-opacity="1" stroke-width="2.22138" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
  </div>
</section>
</div>
<style>
  #shopify-section-{{ section.id }} .image-text-sroll-container {
    display: flex;
    align-items: center;
  }
  
  
  #shopify-section-{{ section.id }} .text-slide-item {
    width:40%;

}
#shopify-section-{{ section.id }} .image-slide-item{
    display: flex;
    width: 60%;
}
#shopify-section-{{ section.id }} .image-slide-item__content{
    overflow:hidden;

}
#shopify-section-{{ section.id }} .image-slide-item img,#shopify-section-{{ section.id }} .image-slide-item video{
width:100%;
height: 100%;
        border-radius:15px;

}

  /* 垂直 Swiper 必须要有明确的高度，可按需修改 */
  #shopify-section-{{ section.id }} .image-slide-swiper,
  #shopify-section-{{ section.id }} .text-slide-swiper {
    height: {{section.settings.block_height}}px; 
    overflow: hidden;
  }
   #shopify-section-{{ section.id }} .text-slide-title{
    font-weight: 600;
    font-size: 24px;
    line-height: 29px;
    letter-spacing: 0px;
    margin-bottom:10px;
   }
   #shopify-section-{{ section.id }} .text-slide-desc{
    font-weight: 400;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0px;
   }
   #shopify-section-{{ section.id }} .image-slide-pagination{
        position: unset;
        align-items: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transform: none;
            margin-left: 40px;
    }
    #shopify-section-{{ section.id }} .swiper-pagination-bullet{
        transition:all .5s ease;
    }
    #shopify-section-{{ section.id }} .swiper-pagination-bullet-active{
        height:47px;
        border-radius:10px;
        background:#979797;
    }
    
  #shopify-section-{{ section.id }} .text-slide-item__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 40px;
  }
  #shopify-section-{{ section.id }} .button-groups{
    display:none;
}
#shopify-section-{{ section.id }} .img-text{
    font-size:15px;
    line-height:1.2;
    font-weight:400;
    margin:0 auto 12px;
    width: fit-content;
}
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .swiper-button-disabled{
        opacity:0.5
    }
    #shopify-section-{{ section.id }} .button-groups{
    display: flex;
    gap: 15px;
    margin-top: 20px;
    }
    #shopify-section-{{ section.id }} .slide-button{
        border: 1px solid;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
       #shopify-section-{{ section.id }} .image-slide-pagination-mob{
        align-items: center;
        display: flex;
        justify-content: center;
    }
    #shopify-section-{{ section.id }} .swiper-pagination-bullet{
        width:7px;
        height:7px;
    }
        #shopify-section-{{ section.id }} .swiper-pagination-bullet-active{
            width:27px;
        height:7px;
        }
   #shopify-section-{{ section.id }} .text-slide-title{
    font-size: 16px;
    line-height: 22px;
    margin-bottom:10px;
   }
   #shopify-section-{{ section.id }} .text-slide-desc{
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0px;
   }
   #shopify-section-{{ section.id }} .image-slide-pagination{
    display:none;
}
    #shopify-section-{{ section.id }} .image-slide-item,
    #shopify-section-{{ section.id }} .text-slide-item {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .image-slide-swiper,
    #shopify-section-{{ section.id }} .text-slide-swiper {
      height: auto;
    }
  #shopify-section-{{ section.id }} .image-text-sroll-container {
    flex-direction:column;  
}
  #shopify-section-{{ section.id }} .text-slide-item__content {
    padding:10px 0;  
}
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function initSectionSwiper() {
      const container = document.querySelector('#shopify-section-{{ section.id }}');
      if (!container) return;

      const imageSwiperEl = container.querySelector('.image-slide-swiper-{{section.id }}');
      const textSwiperEl = container.querySelector('.text-slide-swiper-{{section.id }}');

      if (imageSwiperEl && textSwiperEl && typeof Swiper !== 'undefined') {
        const imageSwiper = new Swiper(imageSwiperEl, {
          slidesPerView: 1,
                mousewheel: true,
          breakpoints:{
            750:{
                direction: 'vertical',
                pagination: {
                    el: ".image-slide-pagination-{{ section.id }}",
                }
            },
            0:{
                spaceBetween:20,
                effect: "slide",
                pagination: {
                    el: ".image-slide-pagination-mob-{{ section.id }}",
                },
                mousewheel: false,
                navigation: {
                    nextEl: ".image-slide-button-next",
                    prevEl: ".image-slide-button-prev",
                },
            }
        }

        });

        const textSwiper = new Swiper(textSwiperEl, {
          slidesPerView: 1,
                mousewheel: true,
           breakpoints:{
            750:{
                direction: 'vertical',
            },
            0:{
                mousewheel: false,
                spaceBetween:20,
            }
        }
        });

        // 实现双向相互控制
        imageSwiper.controller.control = textSwiper;
        textSwiper.controller.control = imageSwiper;
      }
    }

    initSectionSwiper();
    
    // 兼容 Shopify / Shopline 后台编辑器重新加载
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initSectionSwiper();
      }
    });
  });
</script>

{% schema %}
{
  "name": "Media with text scroll",
  "class": "shopify-section--media-with-text-scroll",
  "tag": "section",
  "settings": [
        {
      "type": "select",
      "id": "show_content",
      "label": "模块显示模式",
      "options": [
        {
          "value": "pc",
          "label": "pc端显示"
        },
        {
          "value": "mobile",
          "label": "移动端显示"
        },
        {
          "value": "mobile_pc",
          "label": "双端显示"
        }
      ],
      "default": "mobile_pc"
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "padding-top",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section top"
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section bottom"
    },

    {
      "type": "range",
      "id": "padding-gap",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section gap"
    },

    {
      "type": "header",
      "content": "Width restriction",
      "info": "Section maxWidth"
    },
    {
      "type": "range",
      "id": "max-width",
      "max": 1920,
      "min": 900,
      "step": 20,
      "default": 1600,
      "label": "Section width"
    },
    {
      "type": "range",
      "id": "block_height",
      "max": 1000,
      "min": 300,
      "step": 20,
      "default": 420,
      "label": "模块高度"
    },
    {
      "type": "header",
      "content": "Mob setting"
    },
    {
      "type": "range",
      "id": "padding-top-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section top mob"
    },
    {
      "type": "range",
      "id": "padding-bottom-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section bottom mob"
    },

    {
      "type": "range",
      "id": "padding-gap-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section gap mob"
    },
    {
      "type": "color_background",
      "id": "section-bg",
      "label": "Section background"
    },
    
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "header",
          "content": "数据源"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "video",
          "id": "video_m",
          "label": "Video m"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        },
        {
          "type": "image_picker",
          "id": "image_mob",
          "label": "image Mob"
        },
        {
            "type": "text",
            "id": "img_text",
            "label": "Image label"
        },
        {
          "type": "range",
          "id": "media_width",
          "label": "Image width",
          "min": 30,
          "max": 70,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },

      ]
    }
  ],
  "presets": [
    {
      "name": "Media with text scroll",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
