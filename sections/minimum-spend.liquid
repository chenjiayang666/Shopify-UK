<section id="feature-list-{{ section.settings.anchor_id | default: section.id }}" class="minimum section-padding {% if section.settings.animate %}fade-element{% endif %}">
    <div class="minimum-container section-maxwidth section-gap">
        <div class="min-top">
            {% if section.settings.title != blank %}
              <h2 class="title {{ section.settings.heading_tag }}">{{ section.settings.title }}</h2>
            {% endif %}
            {% if section.settings.subtitle != blank %}
              <div class="subtitle">{{ section.settings.subtitle }}</div>
            {% endif %}
        </div>
        <div class="min-bottom">
            <div class="product-list-container">
                {% for block in section.blocks %}
                    <div class="check-column" >
                        <div class="check-content">
                            <div class="column-check-list">
                                {% comment %} 当前展示项 {% endcomment %}

                                    {% assign first_product ='' %}               
                                    {%- for product in block.settings.product_list -%}
                                        {% assign first_product = product %}               
                                        {% break %}               
                                    {% endfor %}

                                <div class="selectd text-over">
                                    {{ first_product.metafields.custom.custom_title | default:first_product.title | truncate:20 }}
                                </div>
                                <svg t="1758797573891" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4672" width="200" height="200"><path d="M483.072 714.496l30.165333 30.208 415.957334-415.829333a42.837333 42.837333 0 0 0 0-60.288 42.538667 42.538667 0 0 0-60.330667-0.042667l-355.541333 355.413333-355.242667-355.413333a42.496 42.496 0 0 0-60.288 0 42.837333 42.837333 0 0 0-0.085333 60.330667l383.701333 383.872 1.706667 1.749333z" fill="#3D3D3D" p-id="4673"></path></svg>
                            </div>
                            <div class="product-check-list">
                            {%- for product in block.settings.product_list -%}
                            {% assign in_cart = false %}
                                {% if product.metafields.custom.sale_on_second %}
                                {% assign in_cart = true %}
                                {% endif %}
                                <div class="product-tab text-over {% if product.id == first_product.id %}active{% endif %}" {% if in_cart %} data-extrasave={{ product.price | times:0.5 }} data-price={{ product.price| times:0.5 }} {%else %}data-extrasave=0 data-price={{ product.price }}  {% endif %}  data-oldprice="{{ product.compare_at_price }}" data-productId={{ product.id }} data-checkId="{{ block.id }}{{ product.id }}">
                                    {{ product.metafields.custom.custom_title | default:product.title | truncate:20 }}
                                </div>
                            {%- endfor -%}
                            </div>
                        </div>

                        <div class="product-content" >
                            {% for product in block.settings.product_list %}

                            {% assign in_cart = false %}
                                {% if product.metafields.custom.sale_on_second %}
                                {% assign in_cart = true %}
                                {% endif %}

                            <div class="item-card {% if product.id == first_product.id %}active{% endif %}" data-in-cart="{{ in_cart }}" data-checkId="{{ block.id }}{{ product.id }}" data-variantId={{ product.selected_or_first_available_variant.id }}>
                                {%- render 'product-card',
                                    product: product,
                                    stacked: section.settings.stack_products,
                                    position: forloop.index,
                                    background: section.settings.product_card_background,
                                    text_color: section.settings.product_card_text_color,
                                    show_badges: section.settings.show_badges,
                                    enable_discount:in_cart,
                                    discount_level:0.5
                                -%}
                            </div>
                            {% endfor %}

                        </div>

                    </div>
                    {% if forloop.first %}
                      <div class="plus">
                        <svg width="19" height="20" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M11.3059 7.95633H18.7805V11.6946H11.3059V19.1692H7.5686V11.6946H0.0930176V7.95633H7.5686V0.48172H11.3059V7.95633Z" fill="black"/>
                        </svg>
                      </div>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="checkout-container">
                <div class="check-heade">

                <span class="check-heading">Total</span>
                <h3 class="total-price">
                        {% assign init_totalprice = 0 %}    
                        {% assign init_oldprice = 0 %}               
                {% for block in section.blocks %}
                    {%- for product in block.settings.product_list -%}
                        {% assign init_totalprice = init_totalprice | plus:product.price %}               
                        {% assign init_oldprice = init_oldprice | plus:product.compare_at_price %}               
                            {% break %}               
                        {% endfor %}
                {% endfor %}
                {{ init_totalprice | money }}
                </h3>
                </div>
                {% assign init_discount = init_oldprice | minus:init_totalprice %}
                <div class="discount-box">You Save {{ init_discount | money }}</div>
                {% comment %} <span class="discount-tip">( {{ init_totalprice | money }}  + EXTRA ${{ init_discount | money }})</span> {% endcomment %}
                <button class="checkout-button">
                    Proceed to Checkout
                </button>
            </div>
        </div>

    </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const columns = document.querySelectorAll('.check-column');
    const checkoutButton = document.querySelector('.checkout-button');

    // ===============================
    // 下拉选择逻辑
    // ===============================
    columns.forEach(column => {
        const columnCheckList = column.querySelector('.column-check-list');
        const productCheckList = column.querySelector('.product-check-list');
        const selectd = column.querySelector('.selectd');
        const productContent = column.querySelector('.product-content');

        // 点击展开/收起选项
        columnCheckList.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('.product-check-list.active').forEach(el => {
            if (el !== productCheckList) el.classList.remove('active');
        });
        productCheckList.classList.toggle('active');
        });

        // 点击选项切换内容
        productCheckList.querySelectorAll('.product-tab').forEach(tab => {
        tab.addEventListener('click', (e) => {
            e.stopPropagation();

            const checkid = tab.dataset.checkid;
            const text = tab.textContent.trim();

            // 激活当前tab
            productCheckList.querySelectorAll('.product-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            // 更新选中显示文字
            selectd.textContent = text;

            // 切换对应卡片
            if (checkid) {
            productContent.querySelectorAll('.item-card').forEach(card => {
                card.classList.toggle('active', card.dataset.checkid === checkid);
            });
            }

            // 收起
            productCheckList.classList.remove('active');

            // 更新价格显示
            handleSelectedChange();
        });
        });
    });

    // 点击空白关闭所有下拉
    document.addEventListener('click', () => {
        document.querySelectorAll('.product-check-list.active').forEach(el => el.classList.remove('active'));
    });

    // ===============================
    // 价格汇总
    // ===============================
    function handleSelectedChange() {
        console.log('ddddddddddddddd')
        const activeCards = document.querySelectorAll('.product-content .item-card.active');
        let totalPrice = 0;
        let totalCompare = 0;
        let extrasave = 0;

        const products = [];
        let extra=0
        activeCards.forEach(card => {
        const tab = document.querySelector(`.product-tab.active[data-checkid="${card.dataset.checkid}"]`);
        if (!tab) return;

        const price = parseFloat(tab.dataset.price) / 100 || 0;
        extrasave = parseFloat(tab.dataset.extrasave) / 100 || 0;

        const compare = parseFloat(tab.dataset.oldprice) / 100 || 0;
        const title = tab.textContent.trim();

        totalPrice += price;
        totalCompare += compare;
        products.push({ title, price, compare });
        });

        const totalPriceEl = document.querySelector('.total-price');
        const discountBox = document.querySelector('.discount-box');
        {% comment %} const tipBox = document.querySelector('.discount-tip'); {% endcomment %}

        if (discountBox && totalCompare > totalPrice) {
           extra=totalPrice * 0

        const discount_text = `{{ cart.currency.symbol }}${(totalPrice-extra).toLocaleString('en-GB', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        })}`;
        if (totalPriceEl){
             totalPriceEl.textContent = discount_text;
        }
        const save = totalCompare - totalPrice+extra;

        discountBox.textContent = `You Save {{ cart.currency.symbol }}${save.toLocaleString('en-GB', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        })}`;
        {% comment %} tipBox.textContent = `( {{ cart.currency.symbol }}${(save-extra-extrasave).toLocaleString('en-GB', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        })} OFF + EXTRA {{ cart.currency.symbol }}${(extra+extrasave).toLocaleString('en-GB', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        })})`; {% endcomment %}
        } else if (discountBox) {
        discountBox.textContent = 'ss';
        }

        return { totalPrice, totalCompare, products };
    }

    // ===============================
    // 结账按钮事件
    // ===============================
    let items
    checkoutButton.addEventListener('click', async () => {
    const activeCards = document.querySelectorAll('.item-card.active');
    if (activeCards.length === 0) {
        alert('请至少选择一个产品');
        return;
    }

    items = Array.from(activeCards).map(card => ({
        id: card.dataset.variantid,
        quantity: 1
    }));


    // 加载状态开始
    checkoutButton.classList.add('loading');
    checkoutButton.textContent = 'Processing...';

    try {

        // 添加商品
        await fetch('/cart/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
        });

        setTimeout(() => {
        window.location.href = '/checkout';
        }, 500);
    } catch (err) {
        alert('加入购物车失败，请稍后再试');
        checkoutButton.classList.remove('loading');
        checkoutButton.textContent = 'Proceed to Checkout';
    }
    });
  // 初始化价格显示
  handleSelectedChange();
});
</script>



