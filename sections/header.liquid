{%- comment -%}
  IMPLEMENTATION NOTE: Impact header with all the menu is an extremely complex piece of code. Due to requirements from design
  team, we had to cover over hundred of potential combinations. As a consequence, this part (and all the menu snippets) are
  extremely sensitive code that should (if possible) not be touched unless you have spend enough time to study and understand
  the underlying logic of the menu.
{%- endcomment -%}

{%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
  {%- assign will_show_country_selector = true -%}
{%- endif -%}

{%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
  {%- assign will_show_locale_selector = true -%}
{%- endif -%}

<style>
  :root {
    --sticky-header-enabled: {%- if section.settings.enable_sticky -%}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid-template: "main-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    {% comment %} 移动端Header padding，从var(--spacing-3) 收窄到 var(--spacing-2) {% endcomment %}
    --header-padding-block: {% if section.settings.reduce_padding %}var(--spacing-2){% else %}var(--spacing-4-5){% endif %};
    --header-background-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
    --header-background-blur-radius: {{ section.settings.background_blur_radius }}px;
    --header-transparent-text-color: {{ section.settings.transparent_header_text_color.rgb }};

    {%- if section.settings.logo != blank -%}
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
      --header-logo-height: {{ section.settings.logo_mobile_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
    {%- endif -%}

    position: {% if section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 10;
  }

  {%- if section.settings.enable_sticky -%}
    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--sticky-announcement-bar-enabled, 0) * var(--announcement-bar-height, 0px));
      {%- if template.name == 'product' -%}
        top: var(--not-fix-announcement-bar-header-top-value);
      {%- endif -%}
    }
  {%- endif -%}

  {%- if section.settings.opening_from == 'left' -%}
    @media screen and (max-width: 699px) {
      .navigation-drawer {
        --drawer-content-max-height: calc(100vh - (var(--spacing-2) * 2));
        --drawer-content-max-height: calc(100dvh - (var(--spacing-2) * 2));
      }
    }
  {%- endif -%}

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      {%- if section.settings.logo != blank -%}
        --header-logo-width: {{ section.settings.logo_max_width }}px;
        --header-logo-height: {{ section.settings.logo_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
      {%- endif -%}

      --header-padding-block: {% if section.settings.reduce_padding %}var(--spacing-6){% else %}var(--spacing-8-5){% endif %};
    }
  }

  {%- if section.settings.layout contains 'logo_left' -%}
    @media screen and (min-width: 1150px) {
      {%- if section.settings.secondary_menu != blank or will_show_country_selector or will_show_locale_selector -%}
        {%- assign max_percent = '55%' -%}
      {%- else -%}
        {%- assign max_percent = '70%' -%}
      {%- endif -%}

      #shopify-section-{{ section.id }} {
        --header-grid-template: "logo main-nav secondary-nav" / {% if section.settings.layout == 'logo_left_navigation_inline' %}auto minmax(0, 1fr) minmax(0, max-content){% else %}minmax(0, 1fr) fit-content({{ max_percent }}) minmax(0, 1fr){% endif %};
      }
    }
  {%- endif -%}

  {% comment %} 暂时修复header移动端显示问题,不完全保证不影响别的 {% endcomment %}


  @media (min-width: 1200px) and (max-width: 1500px){
    #shopify-section-{{ section.id }} .header__wrapper{
      padding:0 20px;
    }
          #shopify-section-{{ section.id }} {
        --header-grid-template: "logo main-nav secondary-nav" / {% if section.settings.layout == 'logo_left_navigation_inline' %}auto minmax(0, 1fr) minmax(0, max-content){% else %}minmax(0, 1fr) fit-content({{ max_percent }}) minmax(0, 2fr){% endif %};
      }
      #shopify-section-{{ section.id }} .first-level-item{
        padding-left: 15px;
      padding-right: 15px;
      }
  }

  @media(max-width:750px){
    html.lock header{
      top: calc(var(--sticky-announcement-bar-enabled, 0) * var(--announcement-bar-height, 0px)) !important;
      position: fixed !important;
      width: 100%;
    }
  }


  .header-bottom-btn{
    padding:8px 40px;
  }
    .header__dropdown-bar .dropdown-bar__list .dropdown-bar__item {
    color:{{section.settings.level2_color }}
  }
  .header__dropdown-bar .dropdown-bar__list .dropdown-bar__item.active{
    color:{{section.settings.level2_color_active }}
  }
  .mega_item_links{
    padding-bottom:100px;
    margin-left: 13rem;
  }
  .first-level-item{
    position:relative;
  }
  .first-level-item.active .text-with-icon{
    position:relative;
  }
  .first-level-item.active .text-with-icon::after{
    content: "";
    position: absolute;
    bottom: -24px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #0096F9;
  }
  .level-tag{
    position:absolute;
    right:-10px;
    top:10px;
    width: fit-content;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    padding: 0 12px;
    border-radius: 20px;
    z-index: 2;
  }

  @media(max-width:750px){
  .level-tag{
    right: -50px;
    top: -8px;
  }
    #shopify-section-{{ section.id }} .panel-list__wrapper{
       background: white;
      color: black;
    }
     .mega_item_links{
    padding-bottom:0;
    margin-left: 0;
    height:100%;
  }
  .panel-footer{
    padding: 12px var(--drawer-body-margin);
    margin: 0;
    border-top: 1px solid #ecece7;
  }
  .first-level-font{
    font-size:13px;
    line-height:1.2;
    font-weight: 600;
  }
  .third-level-panel__wrapper .v-stack{
        height: 100%;
    display: flex;
    flex-direction: column;
  }
  }
</style>
{%- assign hide_bar = false -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'blacklist' -%}
    {% if block.settings.text == page.handle or block.settings.text == product.title %}
      {%- assign hide_bar = true -%}
    {% endif %}
  {%- endif -%}
{%- endfor -%}

{% unless hide_bar %}
  <height-observer variable="header">
    <store-header
      class="header"
      {% if section.settings.hide_on_scroll %}
        hide-on-scroll="100"
      {% endif %}
      {% if section.settings.enable_sticky %}
        sticky
      {% endif %}
    >
      <dropdown-overlay
        class="dropdown-overlay"
        trigger="{{ section.settings.menu_open_trigger | escape }}"
      ></dropdown-overlay>
      {% comment %} 还必须得放在header__wrapper的上面 {% endcomment %}
      <div class="h5-menu-outer">
        {%- assign main_menu = section.settings.sidebar_menu | default: section.settings.menu -%}
        {%- assign secondary_menu = section.settings.secondary_menu -%}

        {%- if main_menu.links.size > 0 or secondary_menu.links.size > 0 -%}
          <navigation-drawer
            mobile-opening="{{ section.settings.opening_from }}"
            open-from="left"
            tigger-button="header-sidebar-menu"
            class="navigation-drawer dev-drawer {% if section.settings.layout != 'drawer' %}lg:hidden{% endif %}"
          >
            {%- render 'navigation-panel',
              main_menu: main_menu,
              secondary_menu: secondary_menu,
              section: section,
              mobile_opening: section.settings.opening_from,
              layout: section.settings.layout,
              show_social_media: section.settings.show_social_media,
              show_country_selector: section.settings.show_country_selector,
              show_country_name: section.settings.show_country_name,
              show_country_flag: section.settings.show_country_flag,
              show_locale_selector: section.settings.show_locale_selector
            -%}
          </navigation-drawer>
        {%- endif -%}
      </div>
      <div class="header__wrapper">
        {%- comment -%}
          --------------------------------------------------------------------------------------------------------------------
          MAIN NAV AREA
          --------------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
        <div class="header__main-nav">
          <div class="header__icon-list">
            <button type="button" class="menu-switch-button" aria-controls="header-sidebar-menu">
              <div class="menu-switch-button-inner"></div>
            </button>

            <a href="{{ routes.search_url }}" class="tap-area sm:hidden" aria-controls="search-drawer">
              <span class="sr-only">{{ 'header.general.search' | t }}</span>
              {%- render 'icon' with 'search' -%}
            </a>
            {%- if section.settings.layout != 'drawer' and section.settings.menu.links.size > 0 -%}
              {% comment %} 第一级菜单 {% endcomment %}
              <nav
                class="header__link-container {% if section.settings.layout == 'logo_left_navigation_center' %}justify-center{% endif %} wrap"
                role="navigation"
              >
                <div class="header__entry-links">
                  {%- for link in section.settings.menu.links -%}
                    {% if link.links.size > 0 %}
                      {% comment %} 注意加上 - -，避免出现很多空格 {% endcomment %}
                      {%- capture target_index -%}bar-menu-{{ forloop.index }}-0{%- endcapture -%}
                      <mega-menu-button
                        trigger-btn-level="first"
                        trigger="{{ section.settings.menu_open_trigger | escape }}"
                        target-index="{{- target_index -}}"
                        class="first-level-item"
                      >
                        {% for block in section.blocks %}
                          {%if block.type == 'menu_tag' and block.settings.menu_item == link.title  and block.settings.tag != blank%}
                            <div class="level-tag" style="color:{{block.settings.color }};background:{{ block.settings.background }}">{{block.settings.tag }}</div>
                          {% endif %}
                        {% endfor %}
                        <span class="bold gap-2.5 text-with-icon link-faded-reverse">
                          {{ link.title }}
                          {%- render 'icon' with 'chevron-bottom' -%}
                        </span>
                      </mega-menu-button>
                    {% else %}
                      <a
                        href="{{ link.url }}"
                        class="bold first-level-item link-faded-reverse"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- link.title -}}
                      </a>
                    {% endif %}
                  {%- endfor -%}
                </div>
                <div class="header__dropdown-container">
                  <header-dropdown-bar
                    class="header__dropdown-bar"
                    trigger="{{ section.settings.menu_open_trigger | escape }}"
                  >
                    {% comment %} 只有类型为bar的一级菜单，其横条内容会放在这里 {% endcomment %}
                    {%- for link in section.settings.menu.links -%}
                      {% if link.links.size > 0 %}
                        <div class="dropdown-bar__list" bar-menu-index="bar-menu-{{ forloop.index }}-0">
                          <div class="dropdown-bar-content">
                            <div class="dropdown-bar__container">
                              {% for sub_link in link.links %}
                                {% if sub_link.links.size > 0 %}
                                  {% for block in section.blocks %}
                                    {% if block.type == 'mega_item' and block.settings.menu_item == sub_link.title %}
                                      <mega-menu-button
                                        trigger-btn-level="second"
                                        trigger="{{ section.settings.menu_open_trigger | escape }}"
                                        target-index="mega-menu-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                                        class="dropdown-bar__item dropdown-bar_item_trigger second-level-item gap-2.5 link-faded-reverse"
                                      >
                                        {{ sub_link.title }}
                                        <div style="transform:rotate(270deg)">
                                          {%- render 'icon' with 'chevron-bottom' -%}
                                        </div>
                                      </mega-menu-button>
                                    {% endif %}
                                  {% endfor %}
                                {% else %}
                                  <a
                                    href="{{ sub_link.url }}"
                                    class="dropdown-bar__item second-level-item link-faded-reverse"
                                  >
                                    <span class="dropdown-bar__item-text gap-2.5">
                                      {{ sub_link.title }}
                                    </span>
                                  </a>
                                {% endif %}
                              {% endfor %}
                            </div>
                            <div class="dropdown-bar__box">
                              {% for sub_link in link.links %}
                                {% if sub_link.links.size > 0 %}
                                  {% for block in section.blocks %}
                                    {% if block.type == 'mega_item' and block.settings.menu_item == sub_link.title %}
                                      {% comment %} 满足子集菜单的条件，区分多种menu_type的情况{% endcomment %}
                                      {% if block.settings.menu_type == 'type_1' %}
                                        <div class="dropdown-mega_item mega_item_check dropdown-mega_item_trigger">
                                          {% render 'mega-check-block', link: sub_link, block: block %}
                                        </div>
                                      {% endif %}
                                      {% if block.settings.menu_type == 'type_2' %}
                                        <div class="dropdown-mega_item mega_item_grid dropdown-mega_item_trigger">
                                          {% render 'mega-grid-block', link: sub_link, block: block %}
                                        </div>
                                      {% endif %}
                                      {% if block.settings.menu_type == 'type_3' %}
                                        <div class="dropdown-mega_item mega_item_slide dropdown-mega_item_trigger">
                                          {% render 'mega-slide-block', link: sub_link, block: block %}
                                        </div>
                                      {% endif %}
                                      {% if block.settings.menu_type == 'type_4' %}
                                        <div class="dropdown-mega_item mega_item_links dropdown-mega_item_trigger">
                                          {% render 'mega-links-block', link: sub_link, block: block %}
                                        </div>
                                      {% endif %}
                                    {% endif %}
                                  {% endfor %}
                                {% endif %}
                              {% endfor %}
                            </div>
                          </div>

                          <div class="header-dropdown-bottom">
                            {% for sub_link in link.links %}
                              {% if sub_link.links.size > 0 %}
                                {% for block in section.blocks %}
                                  {% if block.type == 'mega_item' and block.settings.menu_item == sub_link.title %}
                                    {% comment %} 满足子集菜单的条件，区分多种menu_type的情况{% endcomment %}
                                    <div class="header-bottom-item header-bottom_item_trigger">
                                      <div class="bottom-wrapper-item">
                                        {% assign left_benefits_array = section.settings.left_benefits | split: ';' %}
                                        <div class="left-benefits-wrap">
                                          {% for left_benefits in left_benefits_array %}
                                            {% assign left_benefits_array_item = left_benefits | split: ',' %}
                                            <div class="benefits-item">
                                              <img
                                                src="{{ left_benefits_array_item[0] }}"
                                                class="benefits-item-icon"
                                                loading="lazy"
                                                alt="{{ left_benefits_array_item[1] }}"
                                                width="20"
                                                height="20"
                                              >
                                              <span class="benefits-item-text">{{ left_benefits_array_item[1] }}</span>
                                            </div>
                                          {% endfor %}
                                        </div>
                                        <div class="dropdown-bottom-button-groups">
                                          {% if block.settings.bottom_group_btn_href != blank %}
                                            <a
                                              href="{{  block.settings.bottom_group_btn_href }}"
                                              class="header-shop-all-btn header-bottom-btn"
                                            >
                                              {{- block.settings.bottom_group_btn_text -}}
                                            </a>
                                          {% endif %}
                                          {% if block.settings.button_group_compare_href != blank %}
                                            <a
                                              style="background:black;color:white;border: 1px solid black;"
                                              class=" header-shop-all-btn header-bottom-btn"
                                              href="{{  block.settings.button_group_compare_href }}"
                                            >
                                              {{- block.settings.button_group_compare_text -}}
                                            </a>
                                          {% endif %}
                                        </div>
                                      </div>
                                    </div>
                                  {% endif %}
                                {% endfor %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </header-dropdown-bar>

                </div>
              </nav>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%}
          --------------------------------------------------------------------------------------------------------------------
          LOGO AREA
          --------------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- capture logo_content -%}
        {%- if section.settings.logo -%}
          {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
          {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}
          <span class="sr-only">{{ shop.name }}</span>
          {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image' -}}

          {%- if section.settings.transparent_logo -%}
            {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text h4">{{ shop.name }}</span>
        {%- endif -%}
      {%- endcapture -%}

        {%- if request.page_type == 'index' -%}
          <h1 class="header__logo">
            <a href="{{ routes.root_url }}">{{ logo_content }}</a>
          </h1>
        {% else %}
          <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
        {% endif %}

        {%- comment -%}
          --------------------------------------------------------------------------------------------------------------------
          SECONDARY NAV AREA
          --------------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        <div class="header__secondary-nav">
          {%- if section.settings.header != 'drawer' and section.settings.secondary_menu.links.size > 0 -%}
            <nav class="header__link-list" role="navigation">
              <ul class="contents">
                {%- for link in section.settings.secondary_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="bold link-faded-reverse">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}

          <ul class="header__icon-list">
            {%- assign has_enabled_countries = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'country_item' and block.settings.enable -%}
                {%- assign has_enabled_countries = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_enabled_countries -%}
              <div class="header-image-container">
                {% comment %}
                  <img src="https://cdn.shopify.com/s/files/1/0627/7457/5183/files/EU-icon.png?v=1744009918" width="30" height="30" />
                  <ul class="header-image-dropdown-content">
                    <li class="country-item">
                      <img src="https://cdn.shopify.com/s/files/1/0946/3234/5909/files/c2eda79560d9d0b31607699845abf77f_430x.png?v=1747620445" class="country-flag" width="28px" height="28px" alt="德国国旗" />
                      <span class="country-name"><a href="https://merachfit.de/" target="_blank">Germany</a></span>
                    </li>
                    <li class="country-item">
                      <img src="https://cdn.shopify.com/s/files/1/0946/3234/5909/files/c07d2406fd8c110061f629dd3ffe5fdf_430x.png?v=1747621056" class="country-flag" width="28px" height="28px" alt="英国国旗" />
                      <span class="country-name"><a href="https://uk.merachfit.com/" target="_blank">U.K</a></span>
                    </li>
                    <li class="country-item">
                      <img src="https://cdn.shopify.com/s/files/1/0946/3234/5909/files/Japan_430x.png?v=1747623769" class="country-flag" width="28px" height="28px" alt="日本国旗" />
                      <span class="country-name"><a href="https://merach.jp/" target="_blank">Japan</a></span>
                    </li>
                  </ul>
                {% endcomment %}
                {%- if section.settings.default_flag_image -%}
                  {{
                    section.settings.default_flag_image
                    | image_url: width: 30
                    | image_tag: width: 30, height: 30, alt: 'Default country flag'
                  }}
                {%- else -%}
                  <img
                    src="https://cdn.shopify.com/s/files/1/0507/1611/5119/files/20251103-150319.png?v=1762154290"
                    width="30"
                    height="30"
                    alt="Default country flag"
                  >
                {%- endif -%}

                <ul class="header-image-dropdown-content">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'country_item' and block.settings.enable -%}
                      <li class="country-item">
                        {%- if block.settings.flag_image -%}
                          {{
                            block.settings.flag_image
                            | image_url: width: 28
                            | image_tag: class: 'country-flag', width: 28, height: 28, alt: block.settings.name
                          }}
                        {%- endif -%}
                        <span class="country-name">
                          <a href="{{ block.settings.link }}" target="_blank">{{ block.settings.name }}</a>
                        </span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
              <li class="hidden md:block shrink-0">
                {%- render 'localization-selector',
                  type: 'country',
                  show_country_name: section.settings.show_country_name,
                  show_country_flag: section.settings.show_country_flag,
                  popover_vertical_position: 'end'
                -%}
              </li>
            {%- endif -%}

            {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
              <li class="hidden md:block shrink-0">
                {%- render 'localization-selector', type: 'locale', popover_vertical_position: 'end' -%}
              </li>
            {%- endif -%}

            <li>
              <a href="{{ routes.search_url }}" class="hidden tap-area sm:block" aria-controls="search-drawer">
                <span class="sr-only">{{ 'header.general.search' | t }}</span>
                {%- render 'icon' with 'search' -%}
              </a>
            </li>

            {%- if shop.customer_accounts_enabled -%}
              <li>
                <a
                  href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
                  class="tap-area sm:block"
                >
                  <span class="sr-only">
                    {%- if customer -%}
                      {{- 'header.general.account' | t -}}
                    {%- else -%}
                      {{- 'header.general.login' | t -}}
                    {%- endif -%}
                  </span>
                  {%- render 'icon' with 'account' -%}
                </a>
              </li>
            {%- endif -%}

            <li>
              <a
                href="{{ routes.cart_url }}"
                data-no-instant
                class="relative block tap-area"
                {% if settings.cart_type != 'page' and request.page_type != 'cart' %}
                  aria-controls="cart-drawer"
                {% endif %}
              >
                <span class="sr-only">{{ 'header.general.cart' | t }}</span>
                {%- render 'icon' with 'cart' -%}

                <div class="header__cart-count">
                  <cart-count class="count-bubble {% if cart.item_count == 0 %}opacity-0{% endif %}">
                    <span class="sr-only">{{ 'cart.general.item_count' | t: count: cart.item_count }}</span>
                    <span aria-hidden="true">{{ cart.item_count }}</span>
                  </cart-count>
                </div>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </store-header>
  </height-observer>
{% endunless %}
{%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  NAVIGATION MENU DRAWER
  --------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<script>
  document.documentElement.style.setProperty(
    '--header-height',
    Math.round(document.getElementById('shopify-section-{{ section.id }}').clientHeight) + 'px'
  );
  document.addEventListener('DOMContentLoaded', () => {
    const lists = document.querySelectorAll('.dropdown-bar__list');

    lists.forEach((list) => {
      const triggers = list.querySelectorAll('.dropdown-bar_item_trigger');
      const megaItems = list.querySelectorAll('.dropdown-mega_item_trigger');
      const bottomItems = list.querySelectorAll('.header-bottom_item_trigger');

      if (!triggers.length || !megaItems.length) return;

      // 默认激活第一个
      triggers[0].classList.add('active');
      megaItems[0].classList.add('active');
      bottomItems[0].classList.add('active');

      // hover切换
      triggers.forEach((trigger, index) => {
        trigger.addEventListener('mouseenter', () => {
          triggers.forEach((item) => {
            item.classList.remove('active');
          });

          megaItems.forEach((item) => {
            item.classList.remove('active');
          });
          bottomItems.forEach((item) => {
            item.classList.remove('active');
          });
          trigger.classList.add('active');

          if (megaItems[index]) {
            megaItems[index].classList.add('active');
          }
          if (bottomItems[index]) {
            bottomItems[index].classList.add('active');
          }

          // 触发外层容器高度重新计算以适应不同二级子级菜单的内容高度
          if (window.megaMenuManager) {
            window.megaMenuManager.updateActiveBarHeight();
          }
        });
      });
    });
  });
</script>

