document.querySelectorAll('.mega-content .product-mega-box_layout').forEach(box => {
  const headers = box.querySelectorAll('.mob-accordion-header');
  const contents = box.querySelectorAll('.mob-accordion-box');

  if (headers.length > 0 && contents.length > 0) {
    // 默认展开第一个
    headers[0].classList.add('active');
    contents[0].classList.add('active');
    contents[0].style.maxHeight = '360px'; 

    // 其他都收起
    contents.forEach((c, i) => {
      if (i !== 0) {
        c.style.maxHeight = '0';
      }
    }); 
  }

  headers.forEach(header => {
    header.addEventListener('click', function () {
      const content = this.nextElementSibling;
      const isActive = this.classList.contains('active');

      // 关闭当前 box 里的所有
      contents.forEach(c => {
        c.style.maxHeight = '0';
        c.classList.remove('active');
      });
      headers.forEach(h => h.classList.remove('active'));

      // 如果不是当前已经展开的，才打开
      if (!isActive) {
        this.classList.add('active');
        content.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';
      }
    });
  });
});
