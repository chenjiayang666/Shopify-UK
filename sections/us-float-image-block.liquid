{% render 'section-settings' %}
<style>
   #shopify-section-{{ section.id }} .float-image-block-item{
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      background: {{ section.settings.card-bg }};
      border-radius:10px;
      overflow:hidden;
      {% comment %} box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15); {% endcomment %}
      height: auto;
        transition: all 0.3s ease; /* 平滑过渡 */
    }
        {% comment %} #shopify-section-{{ section.id }} .float-image-block-item:hover{
        transform: translateY(-3px); /* 稍微上浮 */
        box-shadow: 0 6px 16px rgba(0,0,0,0.25); /* 阴影更浓一些 */
    } {% endcomment %}
   #shopify-section-{{ section.id }} .float-image-block-item-img{
      display: flex;
      align-items: center;
      justify-content: center;
      flex:3;
      overflow:hidden;
  }
   #shopify-section-{{ section.id }} .float-image-block-item-img img,
   #shopify-section-{{ section.id }} .float-image-block-item-img video{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display:flex;
        aspect-ratio: 260 / 305;
    transition: transform 0.3s ease;

    }
    #shopify-section-{{ section.id }} .float-image-block-item-img:hover img{
    transform: scale(1.1);
    }
   #shopify-section-{{ section.id }} .float-image-block-item-info{
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    flex: 1;
    width: 100%;
    gap: 10px;
  }
   #shopify-section-{{ section.id }} .float-image-block-item-info .title{
      font-weight: 600;
      font-size: 20px;
      line-height: 120%;
      color: {{ section.settings.card-title-color }};
  }
   #shopify-section-{{ section.id }} .float-image-block-item-info .subtitle{
    font-weight: 400;
    font-size: 14px;
    line-height: 120%;
    letter-spacing: 0;
    color: {{ section.settings.card_description_color }};
  }
   #shopify-section-{{ section.id }} .block-container{
      display:flex;
      gap:20px;
          align-items: flex-end;
  }
   #shopify-section-{{ section.id }} .block-middle{
      display: flex;
      flex-direction: column;
      gap: 70px;
      width: calc(2 * ((100% - 20px*2 - 20px) / 4) + 20px);
  }
   #shopify-section-{{ section.id }} .float-image-block-item-left,
   #shopify-section-{{ section.id }} .float-image-block-item-right{
        width: calc((100% - 20px*2 - 20px) / 4);
  }
   #shopify-section-{{ section.id }} .middle-float-top{
      display: flex;
      gap: 20px;
  }
     #shopify-section-{{ section.id }} .middle-float-top .float-image-block-item{
      width: calc((100% - 20px) / 2);
  }
   #shopify-section-{{ section.id }} .middle-float-bottom{
      display: flex;
      gap: 20px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
  }
   #shopify-section-{{ section.id }} .tab-header .title{
      background:{{ section.settings.title-color}};
      -webkit-background-clip: text;
      -webkit-text-fill-color:
      background-clip: text;
      color: transparent;
  }
   #shopify-section-{{ section.id }} .tab-header .subtitle{
      background:{{ section.settings.subtitle-color}};
      -webkit-background-clip: text;
      -webkit-text-fill-color:
      background-clip: text;
      color: transparent;
      font-weight: 300;
      font-size: 20px;
      line-height: 26px;
  }
  #shopify-section-{{ section.id }} .tab-header{
    text-align:center;
    }

    @media(max-width:750px){
      #shopify-section-{{ section.id }} .block-container{
        display:none;
      }
      #shopify-section-{{ section.id }} .tab-header{
        text-align:center;
        margin-bottom:30px; 
        padding-right:{{section.settings.padding-gap-mob }}px;
        gap:10px;
        display:flex;
        flex-direction:column;
     }
     #shopify-section-{{ section.id }} .mobile-slide {
      width:100%;
      overflow:hidden;
    }
       #shopify-section-{{ section.id }} .float-image-block-container {
    padding-right: 0;
  }
  #shopify-section-{{ section.id }} .tab-header .subtitle{
      font-size: 16px;
    line-height: 20px;
    font-weight:500;
            max-width: 230px;
        margin: 0 auto;
  }
    }
</style>

<section
   class="float-image-block section-padding">
  <div class="float-image-block-container section-maxwidth section-gap {% if section.settings.animate %}fade-element{% endif %}">
    <div class="block-container sm:block sm-max:hidden">

    {% if section.blocks[0] != blank %}
      {% assign block = section.blocks[0] %}
      <div class="float-image-block-item float-image-block-item-left">
        <div class="float-image-block-item-img">
          {% if block.settings.video != blank %}
            {{-
              block.settings.video
              | video_tag:
                playsinline: true,
                preload: 'metadata',
                autoplay: true,
                muted: true,
                loop: true,
                controls: true,
                image_size: '800x',
                class: 'lazy-video  media'
            -}}
          {% elsif block.settings.image != blank %}
            <a {% if block.settings.url == blank and block.settings.product.url == blank %} style="pointer-events: none;" {% endif %} href="{{ block.settings.url | default: block.settings.product.url }}">
                <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                loading="lazy"
                alt="{{ block.settings.title }}"
                >
            </a>

          {% endif %}
        </div>
        <div class="float-image-block-item-info">
          <h3 class="title">{{ block.settings.title }}</h3>
          <p class="subtitle">{{ block.settings.subtitle | truncate: 70 }}</p>
        </div>
      </div>
    {% endif %}
    {% if section.blocks[1] != blank and section.blocks[2] != blank %}
      <div class="block-middle">
        <div class="middle-float-top">
          {% assign block = section.blocks[1] %}
          <div class="float-image-block-item">
            <div class="float-image-block-item-img">
            {% if block.settings.video != blank %}
                {{-
                block.settings.video
                | video_tag:
                    playsinline: true,
                    preload: 'metadata',
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: true,
                    image_size: '800x',
                    class: 'lazy-video  media'
                -}}
            {% elsif block.settings.image != blank %}
                <a {% if block.settings.url == blank and block.settings.product.url == blank %} style="pointer-events: none;" {% endif %} href="{{ block.settings.url | default: block.settings.product.url }}">
                    <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    loading="lazy"
                    alt="{{ block.settings.title }}"
                    >
                </a>

            {% endif %}
            </div>
            <div class="float-image-block-item-info">
              <h3 class="title">{{ block.settings.title }}</h3>
              <p class="subtitle">{{ block.settings.subtitle | truncate: 70 }}</p>
            </div>
          </div>
          {% assign block = section.blocks[2] %}
          <div class="float-image-block-item">
        <div class="float-image-block-item-img">
          {% if block.settings.video != blank %}
            {{-
              block.settings.video
              | video_tag:
                playsinline: true,
                preload: 'metadata',
                autoplay: true,
                muted: true,
                loop: true,
                controls: true,
                image_size: '800x',
                class: 'lazy-video  media'
            -}}
          {% elsif block.settings.image != blank %}
            <a {% if block.settings.url == blank and block.settings.product.url == blank %} style="pointer-events: none;" {% endif %} href="{{ block.settings.url | default: block.settings.product.url }}">
                <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                loading="lazy"
                alt="{{ block.settings.title }}"
                >
            </a>

          {% endif %}
        </div>
            <div class="float-image-block-item-info">
              <h3 class="title">{{ block.settings.title }}</h3>
              <p class="subtitle">{{ block.settings.subtitle | truncate: 70 }}</p>
            </div>
          </div>
        </div>
        <div class="middle-float-bottom">
          <div class="tab-header">
            {% if section.settings.title != blank %}
              <div class="{{ section.settings.heading_tag }} title">{{ section.settings.title }}</div>
            {% endif %}
            {% if section.settings.subtitle != blank %}
              <div class="subtitle">{{ section.settings.subtitle }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
    {% if section.blocks[3] != blank %}
      {% assign block = section.blocks[3] %}
      <div class="float-image-block-item float-image-block-item-right">
        <div class="float-image-block-item-img">
          {% if block.settings.video != blank %}
            {{-
              block.settings.video
              | video_tag:
                playsinline: true,
                preload: 'metadata',
                autoplay: true,
                muted: true,
                loop: true,
                controls: true,
                image_size: '800x',
                class: 'lazy-video  media'
            -}}
          {% elsif block.settings.image != blank %}
            <a {% if block.settings.url == blank and block.settings.product.url == blank %} style="pointer-events: none;" {% endif %} href="{{ block.settings.url | default: block.settings.product.url }}">
                <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                loading="lazy"
                alt="{{ block.settings.title }}"
                >
            </a>

          {% endif %}
        </div>
        <div class="float-image-block-item-info">
          <h3 class="title">{{ block.settings.title }}</h3>
          <p class="subtitle">{{ block.settings.subtitle | truncate: 70 }}</p>
        </div>
      </div>
    {% endif %}
    </div>
    <div class="mobile-slide sm:hidden sm-max:block">
      <div class="tab-header">
        {% if section.settings.title != blank %}
          <div class="{{ section.settings.heading_tag }} title">{{ section.settings.title }}</div>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <div class="subtitle">{{ section.settings.subtitle }}</div>
        {% endif %}
      </div>
      <div class="slide-container swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="float-image-block-item swiper-slide">
              <div class="float-image-block-item-img">
                {% if block.settings.video != blank %}
                  {{-
                    block.settings.video
                    | video_tag:
                      playsinline: true,
                      preload: 'metadata',
                      autoplay: true,
                      muted: true,
                      loop: true,
                      controls: true,
                      image_size: '800x',
                      class: 'lazy-video  media'
                  -}}
                {% elsif block.settings.image != blank %}
                  <a {% if block.settings.url == blank and block.settings.product.url == blank %} style="pointer-events: none;" {% endif %} href="{{ block.settings.url | default: block.settings.product.url }}">
                      <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      loading="lazy"
                      alt="{{ block.settings.title }}"
                      >
                  </a>

                {% endif %}
              </div>
              <div class="float-image-block-item-info">
                <h3 class="title">{{ block.settings.title }}</h3>
                <p class="subtitle">{{ block.settings.subtitle | truncate: 70 }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  (function(){
    var floatswiper = new Swiper('.swiper-{{ section.id }}', {
          slidesPerView: 1.3,
          spaceBetween: 20,
          breakpoints:{
          0:{
          spaceBetween: 10,
          }
          }
      })
  })()
</script>

{% schema %}
{
  "name": "Float Image Block",
  "class": "float-image-block",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Unique ID for anchor links",
      "default": "multi-column-product-pro"
    },
                {
      "type": "checkbox",
      "id": "animate",
      "label": "启用键入动画",
      "default": true,
      "info": "修改配置的时候关闭"
    },
    {
      "type": "range",
      "id": "padding-top",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section top"
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section bottom"
    },
    {
      "type": "range",
      "id": "padding-gap",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section gap"
    },
    {
      "type": "header",
      "content": "Width restriction",
      "info": "Section maxWidth"
    },
    {
      "type": "range",
      "id": "max-width",
      "max": 1920,
      "min": 1100,
      "step": 20,
      "default": 1600,
      "label": "Section width"
    },
    {
      "type": "header",
      "content": "Mob setting"
    },
    {
      "type": "range",
      "id": "padding-top-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section top mob"
    },
    {
      "type": "range",
      "id": "padding-bottom-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section bottom mob"
    },
    {
      "type": "range",
      "id": "padding-gap-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section gap mob"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "WHY MERACH"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Style",
      "options": [
        {
          "value": "h1",
          "label": "X-Large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h5",
          "label": "X-Small"
        },
        {
          "value": "h6",
          "label": "XX-Small"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color_background",
      "id": "section-bg",
      "label": "Section background"
    },
    {
      "type": "color_background",
      "id": "title-color",
      "label": "Title color",
      "default": "#000"
    },
    {
      "type": "color_background",
      "id": "subtitle-color",
      "label": "Subtitle color",
      "default": "#000"
    },
    {
      "type": "color_background",
      "id": "card-bg",
      "label": "Card background",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "card-title-color",
      "label": "卡片标题颜色",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "card_description_color",
      "label": "卡片描述颜色",
      "default": "#ECECE7"
    },
    
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BarBend"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Discover our new collection of high-quality products."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Float Image Block",
      "blocks": [
        { "type": "block", "settings": { "title": "BarBend" } },
        { "type": "block", "settings": { "title": "BarBend" } },
        { "type": "block", "settings": { "title": "BarBend" } },
        { "type": "block", "settings": { "title": "BarBend" } }
      ]
    }
  ]
}
{% endschema %}
