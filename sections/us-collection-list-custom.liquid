                "label": "卡片间距"
            },
            {
                "type": "header",
                "content":"Color settings"
            },
            {
                "type": "color_background",
                "id": "section-bg",
                "label": "Section background"
            },
            {
                "type": "color",
                "id": "title-color",
                "label": "Title color",
                "default": "#000"
            },
                {
      "type": "color",
      "id": "pag_bg",
      "label": "分页条背景色",
      "default": "#53565A"
    },
    {
      "type": "color",
      "id": "pag_step_bg",
      "label": "分页条step背景色",
      "default": "#ECECE7"
    },
    {
      "type": "header",
      "content": "埋点相关配置"
    },
