      "type": "color",
      "id": "time-tag-color-m",
      "label": "移动端倒计时单位文本色",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "text-width",
      "max": 70,
      "min": 20,
      "step": 1,
      "default": 30,
