    },
    {
      "type": "range",
      "id": "content-pb",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "整个卡片下边距(内边距)"
    },
    {
      "type": "header",
      "content": "Width restriction",
      "info": "Section maxWidth"
    },
    {
      "type": "range",
      "id": "max-width",
      "max": 1600,
      "min": 900,
      "step": 20,
      "default": 1200,
