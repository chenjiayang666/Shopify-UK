    },
    {
      "type": "header",
      "content": "Mob setting"
    },
    {
      "type": "range",
      "id": "padding-top-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section top mob"
    },
    {
      "type": "range",
      "id": "padding-bottom-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section bottom mob"
    },
    {
      "type": "range",
      "id": "padding-gap-mob",
      "max": 100,
      "min": 0,
      "step": 1,
      "default": 20,
      "label": "Section gap mob"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
