      "label": "Time",
      "default": "2025-12-31T23:59:59",
      "info": "时间格式:2025-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sale info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color_background",
      "id": "section-bg",
