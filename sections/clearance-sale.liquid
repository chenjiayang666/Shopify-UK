    },
    {
      "type": "color",
      "id": "time-color",
      "label": "倒计时文本色",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "time-tag-color",
      "label": "倒计时单位文本色",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "text-color",
      "label": "文本文本色",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "移动端颜色设置"
    },
    {
      "type": "color_background",
      "id": "section-bg-m",
      "label": "移动端整个分区背景",
      "default": "#000"
    },
    {
      "type": "color_background",
      "id": "container-bg-m",
      "label": "移动端内容区域的背景",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "text-color-m",
      "label": "移动端文本文本色",
