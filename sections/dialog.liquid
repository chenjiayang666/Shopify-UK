{% render 'section-settings' %}
<style>
  #shopify-section-{{ section.id }} .dialog-section{
        background:{{ section.settings.setion_bg }}
    }
  #shopify-section-{{ section.id }} .custom-container .subheading.p{
      font-weight: 500;
      font-size: 14px;
      line-height: 17px;
      letter-spacing: 0;
  }
      #shopify-section-{{ section.id }} .dialog-button{
        font-weight: 500;
      font-size: 14px;
      line-height: 17px;
        letter-spacing: 0;
        gap:10px;
        cursor:pointer;
      text-align: center;
      width: fit-content;
      margin: 0 auto;
      text-decoration: underline;
    }
    #shopify-section-{{ section.id }} .dialog-content{
        position:fixed;
        width:100%;
        height:100%;
        top:0;
        left:0;
        display:flex;
        justify-content:center;
        align-items:center;
        opacity:0;
        transition:all .5s;
        background: rgba(0,0,0,0.6);
        z-index:-100;
            pointer-events: none;
    }
    #shopify-section-{{ section.id }} .dialog-content.active{
        opacity:1;
        z-index:100;
            pointer-events: auto;
    }
    #shopify-section-{{ section.id }} .dialog-box{
    padding: 50px 40px 50px;
    max-height: 750px;
        z-index:2;
        display:flex;
        width: 100%;
            align-items: center;
            position:relative;
    }
    #shopify-section-{{ section.id }} .dialog-container{
        margin-bottom:20px;
    }
    #shopify-section-{{ section.id }} .log-close{
        position:absolute;
        top:15px;
        right:20px;
        z-index:1;
    }
    #shopify-section-{{ section.id }} .log-close svg{
        width:60px;
        height:60px;
    }
  {% for block in section.blocks %}
    .log-{{ block.id }}{
        color:{{ block.settings.text_color }};
                    background:{{ block.settings.background }};
    max-width: {{block.settings.max_width}}%;
              border-radius:{{ block.settings.radius }}px;


    }
              .inner-padding-{{ block.id }}{
              padding:{{ block.settings.inner_padding }};
          }

          
  {% endfor %}
  @media(max-width:750px){
    #shopify-section-{{ section.id }} .dialog-box{
      max-width:90%;
    }
  }
</style>

<section class="dialog-section section-padding {% if section.settings.animate %}fade-element{% endif %}">
  <div class="container section-gap section-maxwidth">
    {% for block in section.blocks %}
      {% if block.settings.title != blank %}
        <div class="dialog-container  ">
          <div class="dialog-button color:{{ block.settings.button_color }}">
            {{ block.settings['dialog-title'] }}
          </div>
          <div class="dialog-content ">
            <div class="dialog-box log-{{ block.id }} inner-padding-{{ block.id }}">
              <button class="log-close">
                <svg width="112" height="112" viewBox="0 0 112 112" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="55.5703" cy="55.5703" r="36.7959" transform="rotate(45 55.5703 55.5703)" fill="#322826" stroke="#322826" stroke-width="4.99655"/>
                  <path d="M40.4626 41.2661L70.6994 71.5029" stroke="white" stroke-width="4.99655" stroke-linecap="round"/>
                  <path d="M40.4425 71.5011L70.6793 41.2643" stroke="white" stroke-width="4.99655" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="log-lcontent">
                {%- render 'section-header',
                  subheading_size: block.settings.subheading_size,
                  heading_size: block.settings.heading_size,
                  flex_direction: block.settings.flex_direction,
                  flex_align: block.settings.flex_align,
                  subheading: block.settings.subheading,
                  heading: block.settings.title,
                  heading_color: block.settings.heading_color,
                  heading_gradient: block.settings.heading_gradient,
                  content: block.settings.content
                -%}
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      const sectionEl = document.querySelector('#shopify-section-{{ section.id }}');

      // 找到当前 section 下的所有弹窗容器
      const dialogContainers = sectionEl.querySelectorAll('.dialog-container');

      dialogContainers.forEach((container) => {
        const dialogButton = container.querySelector('.dialog-button');
        const dialogOverlay = container.querySelector('.dialog-content');
        const closeButton = container.querySelector('.log-close');

        if (!dialogButton || !dialogOverlay || !closeButton) return;

        // 打开
        dialogButton.addEventListener('click', () => {
          dialogOverlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        });

        // 关闭
        closeButton.addEventListener('click', () => {
          dialogOverlay.classList.remove('active');
          document.body.style.overflow = '';
        });

        // 点击遮罩关闭
        dialogOverlay.addEventListener('click', (e) => {
          if (e.target === dialogOverlay) {
            dialogOverlay.classList.remove('active');
            document.body.style.overflow = '';
          }
        });
      });
    });
  })();
</script>

