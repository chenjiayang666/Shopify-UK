{%- if is_mobile -%}
  <style>
    #mega-slide-mobile-{{ block.id }} {
      --slide-card-bg: {{ block.settings.slide_card_bg | default: '#fafafc' }};
      --slide-title-color: {{ block.settings.slide_title_color | default: '#000000' }};
      --slide-des-color: {{ block.settings.slide_des_color | default: '#777777' }};
      --btn-bg-color: {{ block.settings.slide_btn_bg_color | default: '#000000' }};
      --btn-text-color: {{ block.settings.slide_btn_text_color | default: '#ffffff' }};
    }

    #mega-slide-mobile-{{ block.id }} {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    #mega-slide-mobile-{{ block.id }} .slide-mobile-columns-wrap{
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px 20px;
      background: #fafafc;
    }
    #mega-slide-mobile-{{ block.id }} .header-slide-block-item {
      display: flex;
      flex-direction: column;
      border-radius: 10px;
      background: white;
      position: relative;
      box-sizing: border-box;
      overflow: hidden;
      height: auto;
    }

    #mega-slide-mobile-{{ block.id }} .block-media {
      display: block;
      width: 100%;
      aspect-ratio: 412 / 248;
      overflow: hidden;
      position: relative;
    }

    #mega-slide-mobile-{{ block.id }} .block-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #mega-slide-mobile-{{ block.id }} .block-content {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 15px 20px 15px;
      flex-grow: 1;
    }

    #mega-slide-mobile-{{ block.id }} .block-title {
      font-size: 16px;
      font-weight: 500;
      color: var(--slide-title-color);
      line-height: 1.2;
      overflow: hidden;
      text-overflow: ellipsis;
      text-decoration: none;
    }

    #mega-slide-mobile-{{ block.id }} .block-des {
      font-size: 12px;
      font-weight: 400;
      color: var(--slide-des-color);
      line-height: 16px;
      height: auto;
      max-height: 32px;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    #mega-slide-mobile-{{ block.id }} .block-rating {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
    }

    #mega-slide-mobile-{{ block.id }} .block-price {
      font-size: 14px;
      line-height: 18px;
      font-weight: 500;
      color: var(--slide-title-color);
    }

    #mega-slide-mobile-{{ block.id }} .header-shop-all-btn {
      display: inline-block;
      padding: 6px 16px;
      font-size: 12px;
      line-height: 16px;
      font-weight: 400;
      color: #53565A;
      border: 1px solid;
      border-radius: 20px;
      text-decoration: none;
    }

    #mega-slide-mobile-{{ block.id }} .sale_tag {
      position: absolute;
      left: 10px;
      top: 10px;
      width: fit-content;
      font-size: 12px;
      line-height: 19px;
      font-weight: 600;
      padding: 0 10px;
      border-radius: 20px;
      z-index: 2;
    }

    #mega-slide-mobile-{{ block.id }} .product-card-btn {
      font-size: 12px;
      text-decoration: underline;
      color: #53565A;
    }

    #mega-slide-mobile-{{ block.id }} .block-actions {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    #mega-slide-mobile-{{ block.id }} .block-right-card{
      padding: 12px 20px;
    }
    #mega-slide-mobile-{{ block.id }} .right-card-buttons{
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    #mega-slide-mobile-{{ block.id }} .header-shop-all-btn-xl{
      font-size: 14px;
      line-height: 16px;
      padding: 8px 16px;
    }
  </style>

  <div class="mobile-mega-slide-block" id="mega-slide-mobile-{{ block.id }}">
    {% if block.settings.bottom_group_btn_href != blank or block.settings.button_group_compare_href != blank %}
      <div class="block-right-card">
        <div class="right-card-buttons">
          {% if block.settings.bottom_group_btn_href != blank %}
            <a
              href="{{  block.settings.bottom_group_btn_href }}"
              class="header-shop-all-btn header-bottom-btn header-shop-all-btn-xl"
            >
              {{- block.settings.bottom_group_btn_text -}}
            </a>
          {% endif %}
          {% if block.settings.button_group_compare_href != blank %}
            <a
              style="background:black;color:white;border: 1px solid black;"
              class=" header-shop-all-btn header-bottom-btn header-shop-all-btn-xl"
              href="{{  block.settings.button_group_compare_href }}"
            >
              {{- block.settings.button_group_compare_text -}}
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
    <div class="slide-mobile-columns-wrap">
      {%- for tab_link in link.links -%}
        {%- if tab_link.object.products.size > 0 -%}
          {%- for product in tab_link.object.products limit: 6 -%}
            <div class="header-slide-block-item">
              {% if product.metafields.custom.sale_tag_text != blank %}
                <span
                  class="sale_tag"
                  style="background:{{ product.metafields.custom.sale_tag_background | default:'#0096F9' }};color:{{ product.metafields.custom.sale_tag_color | default:'#fff' }}"
                >
                  {{- product.metafields.custom.sale_tag_text -}}
                </span>
              {% endif %}
              <a class="block-media" href="{{ product.url }}">
                {% if product.metafields.custom.header_slide_image != blank %}
                  <img
                    src="{{ product.metafields.custom.header_slide_image | image_url }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                  >
                {% else %}
                  <img
                    src="{{ product.featured_image | image_url }}"
                    loading="lazy"
                    alt="{{ product.title | escape }}"
                  >
                {% endif %}
              </a>
              <div class="block-content">
                <a class="block-title" href="{{ product.url }}">
                  {{- product.metafields.custom.custom_product_title | default: product.title | truncate: 30 -}}
                </a>
                <div class="block-des">
                  {{ product.metafields.custom.custom_description | metafield_tag | default: product.description }}
                </div>
                <div class="block-rating">
                  <div class="block-price">{{ product.price | money }}</div>
                  <div class="block-actions">
                    {% if product.metafields.custom.custom_cta_url != blank %}
                      <a href="{{ product.metafields.custom.custom_cta_url }}" class="product-card-btn">
                        {{- product.metafields.custom.custom_cta_text | default: 'Explore' -}}
                      </a>
                    {% endif %}
                    <a href="{{ product.url }}" class="shop-all-btn header-shop-all-btn">Shop Now</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
  <style>
      #header-slide-block-container-{{ block.id }} {
        --slide-card-bg: {{ block.settings.slide_card_bg | default: '#fafafc' }};
        --slide-title-color: {{ block.settings.slide_title_color | default: '#000000' }};
