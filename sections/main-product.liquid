{%- render 'section-spacing-collapsing' -%}

<style>
  .product-info__liquid .payment-icons-container{
    margin: var(--spacing-4) -5px !important;
  }
  #shopify-section-{{ section.id }} {
    --product-grid: auto / minmax(0, 1fr);
    --product-gallery-media-list-grid: auto / auto-flow {% if section.settings.mobile_carousel_control == 'free_scroll' %}{% if section.settings.mobile_media_size == 'expanded' %}84vw{% else %}73vw{% endif %}{% else %}100%{% endif %};
    --product-gallery-media-list-gap: {% if section.settings.mobile_media_size == 'expanded' %}var(--spacing-0-5){% else %}var(--grid-gutter){% endif %};
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      --section-spacing-block-start: {% if section.settings.mobile_media_size == 'expanded' %}0px{% else %}var(--container-gutter){% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- assign media_ratio = section.settings.desktop_media_width | divided_by: 50.0 -%}
      --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
      --product-gallery-media-list-grid: {% if section.settings.desktop_media_layout contains 'grid' %}auto-flow dense / repeat({% if section.settings.desktop_media_layout == 'grid_one' %}1{% else %}2{% endif %}, minmax(0, 1fr)){% else %}auto / auto-flow 100%{% endif %};
      --product-gallery-media-list-gap: calc(var(--grid-gutter) / 2);
    }

    {%- if section.settings.desktop_media_layout == 'grid_highlight' -%}
      #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) {
        grid-column: span 2;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) ~ *:not(.product-gallery__media--expand) {
        grid-column: span 1;
      }
    {%- endif -%}
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-gap: var(--grid-gutter);
    }
  }
  .product-info .product-info__quantity-selector{
    margin-bottom: var(--spacing-2);
  }
  @media screen and (min-width: 769px) {
     .product-info__buy-buttons .buy-buttons{
    display: flex;
    flex-direction: column;
  }
  .product-info__buy-buttons .buy-buttons .button{
    align-self:end;
    width: calc(100% - 154px);
  }
  .product-info__buy-buttons .shopify-payment-button{
    width: 100%;
  }
  .product-info .product-info__action-group{
    position: relative;
  }
  .product-info .product-info__quantity-selector{
    position: absolute;
    top: 5px;
  }
  .product-info .product-info__quantity-selector label{
    display: none;
  }
  }
   .product-info .product-info__block-item .product-form__share{
    padding: var(--gw-space-base) 0;
  }
      /* 新增移动端样式（示例宽度 768px，可根据需求调整） */
  @media screen and (max-width: 768px) {
    .product-info .product-info__quantity-selector label{
    display: block;
  }
    .product-info .product-info__quantity-selector .form-control {
      display: flex;
      align-items: center;
      gap: var(--spacing-2)
    }
    .product-info .product-info__quantity-selector .form-control .quantity-selector__input{
      width: 100%;
    }
    .product-info .product-info__quantity-selector .form-control .quantity-selector{
      width: 100%;
    }

  }
  .product-info .sale-tag{
    display:flex;
    gap:15px;
  }
  .product-info .tag-item{
    flex: 1;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    font-size: 12px;
    max-width: 180px;
    background:#D9D9D9;
  }

  .coupon-clip {
  position: relative;
  overflow: hidden;
}

.coupon-clip{
  --r: 8px; /* 洞的半径 */


  -webkit-mask:
    radial-gradient(circle var(--r) at 0 0,
      transparent 99%,
      #f8f8f8 100%),
    radial-gradient(circle var(--r) at 100% 0,
      transparent 99%,
      #f8f8f8 100%),
    radial-gradient(circle var(--r) at 0 100%,
      transparent 99%,
      #f8f8f8 100%),
    radial-gradient(circle var(--r) at 100% 100%,
      transparent 99%,
      #f8f8f8 100%);
  -webkit-mask-composite: destination-in;
}
.ellipsis2{
    max-width: 360px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    white-space: normal;
}


</style>

{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div {% render 'section-properties', tight: true %}>
  <product-rerender
    id="product-info-{{ product.id }}-{{ section.id }}"
    observe-form="{{ product_form_id }}"
    allow-partial-rerender
  >
    <div class="product">
      {%- if product.media.size > 0 -%}
        {%- render 'product-gallery', product: product, product_form_id: product_form_id -%}
      {%- endif -%}

      {%- render 'product-info',
        product: product,
        update_url: true,
        product_form_id: product_form_id,
        context: 'main_product'
      -%}
    </div>
  </product-rerender>
</div>

{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

{%- if section.settings.show_fixed_add_to_cart and product.available and buy_buttons_block != blank -%}
  <product-rerender id="{{ product_form_id }}-sticky-bar" observe-form="{{ product_form_id }}">
    {%- if product.selected_or_first_available_variant.available -%}
      <product-quick-add form="{{ product_form_id }}" class="product-quick-add">
        {%- assign button_label = 'product.general.add_to_cart_button' | t -%}



        {%- assign image = product.selected_or_first_available_variant.featured_media
          | default: product.featured_media
        -%}

        <div class="product-quick-add__variant {% if image == blank %}no-image{% endif %} grid">
          {%- if image != blank -%}
            <variant-media class="hidden sm:flex" widths="80,160" form="{{ product_form_id }}">
              {{-
                image
                | image_url: width: image.width
                | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', class: 'rounded-xs'
              -}}
            </variant-media>
          {%- endif -%}

          <div class="v-stack gap-0.5 hidden sm:flex">
            {%- assign vendor_block = section.blocks | where: 'type', 'vendor' -%}

            {%- if vendor_block != blank -%}
              {%- render 'vendor' with product.vendor, class: 'text-xs' -%}
            {%- endif -%}

            <a href="{{ product.url }}" class="bold truncate-text ellipsis2">{{ product.title }}</a>

          </div>


          <div class="quick-groups">

            {%- render 'price-list',
              product: product,
              variant: product.selected_or_first_available_variant,
              form_id: product_form_id,
              show_cutdown: buy_buttons_block.settings.show_cutdown,
              sale_cutdown:buy_buttons_block.settings.sale_cutdown,
              cutdown_color:buy_buttons_block.settings.cutdown_color,
              cutdown_text:buy_buttons_block.settings.cutdown_text
            -%}
          <div class="groups">
            <div class="product-buttons" >
            <buy-buttons
              template="{{ product.template_suffix }}"
              form="{{ product_form_id }}"
              force-secondary-button
              class="pc-none mob-flex icon-buy"
            >
              {%- render 'button',
                type: 'submit',
                content: button_label,
                only_icon:true,
                form: product_form_id,
                icon:'quick-buy-cart',
                background: buy_buttons_block.settings.atc_button_background,
                text_color: buy_buttons_block.settings.atc_button_text_color,
                secondary: true,
                style:buy_buttons_block.settings.add_style
              -%}
            </buy-buttons>
              <div class="product-check">
                <buy-buttons
                  template="{{ product.template_suffix }}"
                  form="{{ product_form_id }}"
                  force-secondary-button
                >
                  {%- render 'button',
                    type: 'submit',
                    content: button_label,
                    form: product_form_id,
                    background: buy_buttons_block.settings.atc_button_background2,
                    text_color: buy_buttons_block.settings.atc_button_text_color2,
                    secondary: true,
                    custom_button:buy_buttons_block.settings.buy_text,
                    custom_class:' go-checkout',
                    style:buy_buttons_block.settings.buy_style
                  -%}
                </buy-buttons>
              </div>

            </div>

            <buy-buttons
              template="{{ product.template_suffix }}"
              form="{{ product_form_id }}"
              force-secondary-button
              class="pc-flex mob-none"
            >
              {%- render 'button',
                type: 'submit',
                content: button_label,
                form: product_form_id,
                background: buy_buttons_block.settings.atc_button_background,
                text_color: buy_buttons_block.settings.atc_button_text_color,
                secondary: true,
                style:buy_buttons_block.settings.add_style
              -%}
            </buy-buttons>
          </div>
          </div>

        </div>
      </product-quick-add>
    {%- endif -%}
  </product-rerender>
{%- endif -%}

{%- comment -%}
  IMPLEMENTATION NOTE: Shopify does not currently allows to render a given section within the context of a given product. However,
  when rendering the quick buy popovers, we want to be able to re-use the merchant's choices (such as the selector type). This
  is however only possible by rendering the whole product page, and extracting the relevant part. Here, we therefore render the
  quick buy information in a template, that will be extracted in JS, but ensure it is not visible in the main product page
{%- endcomment -%}

{%- render 'product-quick-buy', product: product -%}
<script>
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      // 选中所有 code-box
      const codeBoxes = document.querySelectorAll('#shopify-section-{{ section.id }} .copy-code');
      if (!codeBoxes.length) return;
      codeBoxes.forEach((codeBox) => {
        codeBox.querySelector('button').addEventListener('click', async () => {
          const code = codeBox.querySelector('button').dataset.code;
          if (!code) return;

          try {
            // 复制到剪贴板
            await navigator.clipboard.writeText(code);

            // 弹窗提示
            const popup = document.createElement('div');
            popup.textContent = '已复制优惠码'; // 例如“已复制优惠码”
            popup.className = 'copy-popup';
            document.body.appendChild(popup);

            // 居中显示
            requestAnimationFrame(() => popup.classList.add('show'));

            // 自动关闭
            setTimeout(() => {
              popup.classList.remove('show');
              setTimeout(() => popup.remove(), 300);
            }, 2000);
          } catch (err) {
            alert('复制失败，请手动复制');
          }
        });
      });
    });
  })();
</script>
<script>
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      const productButtonBox = document.querySelector('.product-check');
      if (!productButtonBox) return;

      const formId = productButtonBox.querySelector('button[type="submit"]')?.getAttribute('form');
      if (!formId) return;

      const form = document.getElementById(formId);
      if (!form) return;


      form.addEventListener('submit', (e) => {
        const submitBtn = e.submitter;

        // 只对特定按钮生效
        if (!submitBtn || !submitBtn.classList.contains('go-checkout')) return;

        setTimeout(() => {
          window.location.href = '/checkout';
        }, 300);
      });
    });
  })();
</script>
