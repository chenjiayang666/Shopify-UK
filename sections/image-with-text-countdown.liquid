{%- unless section.settings.full_width -%}
  {%- render 'section-spacing-collapsing' -%}
{%- endunless -%}

<div
  id="feature-list-{{ section.settings.anchor_id | default: section.id }}"
  {% render 'section-properties' %}
  {% if section.settings.allow_transparent_header %}
    allow-transparent-header
  {% endif %}
>
  {%- capture class -%}content-over-media content-over-media--{{ section.settings.image_size }} {% if section.settings.full_width %}full-bleed{% else %}shadow-block rounded-lg{% endif %}{%- endcapture -%}

  <image-banner
    reveal-on-scroll="true"
    class="countdown-image-banner"
    style="
      {% if section.settings.image != blank %}
        background-image: url('{{ section.settings.image | image_url }}');
        background-size: cover;
        background-position: center;
        {% assign img_ratio = section.settings.image.height | times: 100.0 | divided_by: section.settings.image.width %}
        padding-top: {{ img_ratio }}%;
      {% else %}
        background-color: {{ section.settings.countdown_bg_color }};
        padding-top: 0;
      {% endif %}
      position: relative;
      width: 100%;
      display: block;
        height: 100%;
      {% if section.settings.image != blank %}
        overflow: hidden;
      {% endif %}
    "
    {% if section.settings.image != blank %}
      data-original-width="{{ section.settings.image.width }}"
      data-original-height="{{ section.settings.image.height }}"
    {% endif %}
  >
    {%- if section.settings.image != blank -%}
      {%- capture sizes -%}{% if section.settings.full_width %}100vw{% else %}(max-width: 740px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 64px), min({{ settings.page_width }}px, 100vw - 96px){% endif %}{%- endcapture -%}
      {%- capture fetch_priority -%}{% if section.index == 1 %}high{% else %}low{% endif %}{%- endcapture -%}

      <!-- 背景图容器：添加原始宽高数据属性 -->
      <div
        class="countdown-image-background"
        style="background-image: url('{{ section.settings.image | image_url }}'); {% if section.settings.mobile_image != blank %}@media (max-width: 699px) {background-image: url('{{ section.settings.mobile_image | image_url }}'); }{% endif %}"
        data-original-width="{{ section.settings.image.width }}"
        data-original-height="{{ section.settings.image.height }}"
        {% if section.settings.mobile_image != blank %}
          data-mobile-width="{{ section.settings.mobile_image.width }}"
          data-mobile-height="{{ section.settings.mobile_image.height }}"
        {% endif %}
      ></div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="{{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }} countdown-place">
        <div class="prose">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'subheading' -%}
                {%- if block.settings.text != blank -%}
                  <p class="bold" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.text != blank -%}
                  <p
                    class="{{ block.settings.heading_tag }}"
                    {% if settings.heading_apparition != 'none' %}
                      reveal-on-scroll="true"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'styled-text', content: block.settings.text, apparition_effect: true -%}
                  </p>
                {%- endif -%}

              {%- when 'richtext' -%}
                {%- if block.settings.content != blank -%}
                  <div {{ block.shopify_attributes }}>
                    {{- block.settings.content -}}
                  </div>
                {%- endif -%}

              {%- when 'liquid' -%}
                {%- if block.settings.liquid != blank -%}
                  <div {{ block.shopify_attributes }}>
                    {{- block.settings.liquid -}}
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- if block.settings.text != blank -%}
                  {% render 'button',
                    content: block.settings.text,
                    href: block.settings.url,
                    size: block.settings.size,
                    style: block.settings.style,
                    background: block.settings.background,
                    text_color: block.settings.text_color,
                    block: block
                  %}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
          <div
            class="countdown-content"
            style="
              display: flex; align-items: center; justify-content: center;
              width: 100%; height: 100%;
            "
          >
            <div id="countdown-{{ section.id }}" class="countdown-wrapper">
              <!-- 天数 -->
              <div class="countdown-block">
                <div class="countdown-number-container">
                  <div class="countdown-digit days-tens">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                  <div class="countdown-digit days-units">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                </div>
                <div class="countdown-label">Days</div>
              </div>

              <!-- 小时 -->
              <div class="countdown-block">
                <div class="countdown-number-container">
                  <div class="countdown-digit hours-tens">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                  <div class="countdown-digit hours-units">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                </div>
                <div class="countdown-label">Hours</div>
              </div>

              <!-- 分钟 -->
              <div class="countdown-block">
                <div class="countdown-number-container">
                  <div class="countdown-digit minutes-tens">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                  <div class="countdown-digit minutes-units">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                </div>
                <div class="countdown-label">Minutes</div>
              </div>

              <!-- 秒钟 -->
              <div class="countdown-block">
                <div class="countdown-number-container">
                  <div class="countdown-digit seconds-tens">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                  <div class="countdown-digit seconds-units">
                    <div class="countdown-flip">
                      <div class="countdown-flip-part countdown-flip-top current-top flipping"></div>
                      <div class="countdown-flip-part countdown-flip-bottom">0</div>
                      <div class="countdown-flip-part countdown-flip-top next-top flipping"></div>
                    </div>
                  </div>
                </div>
                <div class="countdown-label">Seconds</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </image-banner>
</div>

