<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = "{{ section.id }}";
  const countdownElement = document.getElementById(`countdown-${sectionId}`);
  
  if (!countdownElement) return;
  
  // 获取结束时间设置
  const endTimeStr = "{{ section.settings.countdown_end_time }}";
  
  if (!endTimeStr) {
    console.error('Countdown end time is not set');
    return;
  }
  
  // 解析时间
  const endTime = new Date(endTimeStr);
  
  // 存储当前显示的值
  let currentValues = {
    days: '00',
    hours: '00',
    minutes: '00',
    seconds: '00'
  };
  
  // 更新倒计时
  function updateCountdown() {
    const now = new Date();
    let timeDifference = endTime - now;
    // 如果时间已过，设置为0
    if (timeDifference < 0) {
      timeDifference = 0;
      clearInterval(timer);
      // 可以在这里添加活动结束后的处理逻辑
    }
    
    // 计算时间单位
    const days = Math.floor(timeDifference / (1000 * 60 * 60 * 24));
    const hours = Math.floor((timeDifference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((timeDifference % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((timeDifference % (1000 * 60)) / 1000);
    
    // 格式化时间
    const formattedDays = days.toString().padStart(2, '0');
    const formattedHours = hours.toString().padStart(2, '0');
    const formattedMinutes = minutes.toString().padStart(2, '0');
    const formattedSeconds = seconds.toString().padStart(2, '0');
    
    // 更新数字并执行翻转动画
    updateDigit('days-tens', formattedDays.charAt(0), currentValues.days.charAt(0));
    updateDigit('days-units', formattedDays.charAt(1), currentValues.days.charAt(1));
    updateDigit('hours-tens', formattedHours.charAt(0), currentValues.hours.charAt(0));
    updateDigit('hours-units', formattedHours.charAt(1), currentValues.hours.charAt(1));
    updateDigit('minutes-tens', formattedMinutes.charAt(0), currentValues.minutes.charAt(0));
    updateDigit('minutes-units', formattedMinutes.charAt(1), currentValues.minutes.charAt(1));
    updateDigit('seconds-tens', formattedSeconds.charAt(0), currentValues.seconds.charAt(0));
    updateDigit('seconds-units', formattedSeconds.charAt(1), currentValues.seconds.charAt(1));
    
    // 更新当前值
    currentValues = {
      days: formattedDays,
      hours: formattedHours,
      minutes: formattedMinutes,
      seconds: formattedSeconds
    };
  }
  
  // 更新单个数字的显示并执行动画
  function updateDigit(digitClass, newValue, oldValue) {
   const digitElements = document.querySelectorAll(`.${digitClass}`);
  
  digitElements.forEach(digitElement => {
    const flipElement = digitElement.querySelector('.countdown-flip');
    if (!flipElement) return;
    
    const currentTop = flipElement.querySelector('.current-top');
    const nextTop = flipElement.querySelector('.next-top');
    const bottom = flipElement.querySelector('.countdown-flip-bottom');
    
    if (!currentTop || !nextTop || !bottom) return;

    // 如果数字没有变化，不执行动画
    if (oldValue === newValue) return;
    
    // 创建数字内容容器（如果不存在）
    let currentTopContent = currentTop.querySelector('.digit-content');
    if (!currentTopContent) {
      currentTopContent = document.createElement('div');
      currentTopContent.className = 'digit-content';
      currentTop.appendChild(currentTopContent);
    }
    
    // 设置数字内容
    // currentTopContent.textContent = newValue;
    bottom.textContent = newValue;
    // 添加动画类
    // currentTop.classList.add('flipping');
    
    // 执行翻转动画
    // currentTop.style.transform = 'rotateX(-180deg)';
    // // 动画结束后重置状态
    // setTimeout(() => {
    //   // bottom.textContent = newValue;
    //   currentTop.style.transform = 'rotateX(0deg)';
      
    //   currentTop.classList.remove('flipping');
    // }, 600);
  });
  }
  
  // 初始更新
  updateCountdown();
  
  // 设置定时器，每秒更新一次
  const timer = setInterval(updateCountdown, 1000);
});
</script>
<style>
     .countdown-flip-part {
     position: relative;
     /* 其他样式保持不变 */
   }

   .digit-content {
     position: absolute;
     width: 100%;
     height: 100%;
     display: flex;
     /* align-items: center; */
     justify-content: center;
     transform: rotateX(0deg); /* 抵消父元素的旋转 */
     backface-visibility: hidden; /* 防止翻转时出现闪烁 */
     color: {{ section.settings.text_color }};
     /* font-size: 36px; */
     /* line-height: 50px; */
     overflow: hidden;
     font-weight: bold;
   }
