{% render 'section-settings' %}
<style>
      #shopify-section-{{ section.id }} .section-inner{
        padding: {{ section.settings.block_inner_padding }};
      }
      #shopify-section-{{ section.id }} .image-width-text-custom{
          background-color: {{ section.settings.section_bg }};
          {% if section.settings.section_background_image != blank %}
              background-image:url({{ section.settings.section_background_image | img_url:'master' }});
              background-size: cover;
              background-position: center;
          {% endif %}

      }
      #shopify-section-{{ section.id }} img.media{
        height:100%;
      }
      #shopify-section-{{ section.id }} .custom-container{
          background-color: {{ section.settings.block_bg }};
          border-radius: {{ section.settings.radius }}px;
              display: flex;
              align-items: stretch;
        justify-content: space-between;
      }

    #shopify-section-{{ section.id }} .custom-container .text{
        {% comment %} font-weight: 300;
        font-size: 12px;
        line-height: 150%; {% endcomment %}
        letter-spacing: 0;
        height:auto;
            display: flex;

    }
    #shopify-section-{{ section.id }} .custom-container .subheading.p{
        font-weight: 500;
        font-size: 14px;
        line-height: 17px;
        letter-spacing: 0;
    }
    #shopify-section-{{ section.id }} .custom-block{
      display:flex;
      flex-direction: column;
      gap:8px;
      margin-top:20px;
  }
      {% for block in section.blocks %}

        @media(min-width:750px){

          .width-{{ block.id }}{
              width:{{ block.settings.width }}%;
          }
        }

          .redius-{{ block.id }}{
              border-radius:{{ block.settings.radius }}px;
                  overflow: hidden;
          }
        {%- case block.type -%}
          {%- when 'media' -%}
           .media-{{ block.id }}{

              }
          {%- when 'text' -%}
          #shopify-section-{{ section.id }} .text-{{ block.id }}{
            color:{{ block.settings.text_color }};
            {% if block.settings.bg_image != blank %}
              background-image:url({{ block.settings.bg_image | img_url:'master' }});
              background-size: cover;
              background-position: center;
            {% else %}
            background:{{ block.settings.background }};
            {% endif %}
            box-shadow:{{ block.settings.block-shadow }};
            flex-direction: {{block.settings.flex_direction_box}};
          }
          .inner-padding-{{ block.id }}{
              padding:{{ block.settings.inner_padding }};
          }
          #shopify-section-{{ section.id }} .text-{{ block.id }} .text-item{
              color:{{ block.settings.text_block_color }};
              background:{{ block.settings.text_block_gradient }};
              font-weight: 300;
              font-size: 12px;
              line-height: 150%;
              letter-spacing: 0;
              padding:11.5px 12.5px;
              border-radius: 8px;
          }
          @media(max-width:750px){
          .inner-padding-{{ block.id }}{
              padding:{{ block.settings.inner_padding_mob }};
          }
          #shopify-section-{{ section.id }} .text-{{ block.id }}{
            {% if block.settings.bg_image_mob != blank %}
              background-image:url({{ block.settings.bg_image_mob | img_url:'master' }});
            {% endif %}
          }
          }
        {%- endcase -%}
      {% endfor %}
      #shopify-section-{{ section.id }} .decorate_image{
        margin:0 auto;
      }

      @media(max-width:750px){
        #shopify-section-{{ section.id }} .custom-container{
          flex-direction:column;
          gap:20px;
        }
              #shopify-section-{{ section.id }} .section-inner{
        padding: {{ section.settings.block_inner_padding_mob }};
      }
      #shopify-section-{{ section.id }} .image-width-text-custom{
          {% if section.settings.section_background_image_mob != blank %}
              background-image:url({{ section.settings.section_background_image_mob | img_url:'master' }});
          {% endif %}

      }
      }
</style>

<section class="image-width-text-custom section-padding section-gap {% if section.settings.animate %}fade-element{% endif %}">
  <div class="custom-container  section-maxwidth section-inner">
    {% for block in section.blocks %}
      {%- case block.type -%}
        {%- when 'media' -%}
          <div class="media width-{{ block.id }} redius-{{ block.id }} media-{{ block.id}}">
            {% if block.settings.video != blank %}
              <div class="video-wrapper sm:block sm-max:hidden">
                {{-
                  block.settings.video
                  | video_tag:
                    playsinline: true,
                    preload: 'metadata',
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: false,
                    image_size: '800x',
                    class: 'lazy-video  media pc-video'
                -}}
              </div>

            {% elsif block.settings.image != blank %}
              <img
                class="sm:block sm-max:hidden media"
                src="{{ block.settings.image | img_url:'' }}"
                alt="{{ block.settings.image.alt }}"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.video_m != blank %}
              <div class="video-wrapper sm:hidden sm-max:block">
                {{-
                  block.settings.video_m
                  | video_tag:
                    playsinline: true,
                    preload: 'metadata',
                    muted: true,
                    loop: true,
                    autoplay: true,
                    controls: false,
                    image_size: '800x',
                    class: 'lazy-video  media'
                -}}
              </div>
            {% elsif block.settings.image_mob != blank %}
              <img
                class="sm:hidden sm-max:block media"
                src="{{ block.settings.image_mob | img_url:'' }}"
                alt="{{ block.settings.image_mob.alt }}"
                loading="lazy"
              >
            {% endif %}
          </div>
        {%- when 'text' -%}
          <div
            data-align="{{ block.settings.flex_align_box }}"
            class="text width-{{ block.id }} inner-padding-{{ block.id }} redius-{{ block.id }} text-{{ block.id }}"
          >
            {%- render 'section-header',
              subheading_size: block.settings.subheading_size,
              heading_size: block.settings.heading_size,
              flex_direction: block.settings.flex_direction,
              flex_align: block.settings.flex_align,
              subheading: block.settings.subheading,
              heading: block.settings.title,
              heading_color: block.settings.heading_color,
              heading_gradient: block.settings.heading_gradient,
              content: block.settings.content
            -%}
            <div class="custom-block">
              {% for i in (1..4) %}
                {% capture text_block %}text_block{{ i }}{% endcapture %}
                {% if block.settings[text_block] != blank %}
                  <div class="text-item">
                    {{ block.settings[text_block] }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            {% if block.settings.decorate_image != blank %}
              <img
                class="decorate_image  media"
                src="{{ block.settings.decorate_image | img_url:'' }}"
                alt="{{ block.settings.decorate_image.alt }}"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.liquid != blank %}
              <div class="liquid-container">
                {{ block.settings.liquid }}
              </div>
            {% endif %}
          </div>
      {%- endcase -%}
    {% endfor %}
  </div>
</section>

